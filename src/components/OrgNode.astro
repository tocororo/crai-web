---
const { node, level } = Astro.props;
---
{typeof node === 'string' ? (
  <div class:list={['org-node', level === 1 && 'level-1']}>{node}</div>
) : (
  <>
    <div class:list={['org-node-branch', level === 1 && 'level-1']}>{node.label}</div>
    {node.children && node.children.length > 0 && (
      <div class="org-children">
        {node.children.map((child) => (
          <div class="org-child">
            {typeof child === 'string' ? child : child.label}
            {child.children && child.children.length > 0 && (
              <div class="org-children org-children--vertical" style="margin-top:8px;">
                {child.children.map((grandchild) => (
                  <div class="org-child">{typeof grandchild === 'string' ? grandchild : grandchild.label}</div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    )}
  </>
)}
