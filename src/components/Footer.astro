---
import { getSiteConfig } from '../lib/content';

const config = await getSiteConfig();
const contact = config?.contact;
const social = config?.social;
const footer = config?.footer;
const siteName = config?.siteName ?? 'CRAI';
---

<footer class="bg-slate-900 text-gray-300">
  <div class="container-crai py-14">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <h3 class="font-heading text-xl font-bold text-white">{siteName}</h3>
        <p class="text-sm leading-relaxed">{footer?.description}</p>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start gap-2"><i class="fas fa-map-marker-alt mt-1 text-primary-400"></i> {contact?.address}</li>
          <li class="flex items-center gap-2"><i class="fas fa-phone text-primary-400"></i> {contact?.phone}</li>
          <li class="flex items-center gap-2"><i class="fas fa-envelope text-primary-400"></i> {contact?.email}</li>
        </ul>
        <div class="flex gap-3">
          {social && Object.entries(social).filter(([, v]) => v).map(([key, url]) => (
            <a href={url} aria-label={key} class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-primary-500 hover:text-white">
              <i class={`fab fa-${key === 'twitter' ? 'twitter' : key === 'facebook' ? 'facebook-f' : key === 'linkedin' ? 'linkedin-in' : key}`}></i>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3 class="mb-4 font-heading text-lg font-bold text-white">{footer?.quickLinksTitle}</h3>
        <ul class="space-y-2 text-sm">
          {footer?.quickLinks.map((link) => (
            <li>
              <a href={link.url} class="inline-flex items-center gap-2 transition-colors hover:text-primary-400">
                <i class="fas fa-chevron-right text-[10px] text-primary-400"></i> {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-heading text-lg font-bold text-white">{footer?.servicesTitle}</h3>
        <ul class="space-y-2 text-sm">
          {footer?.services.map((link) => (
            <li>
              <a href={link.url} class="inline-flex items-center gap-2 transition-colors hover:text-primary-400">
                <i class="fas fa-chevron-right text-[10px] text-primary-400"></i> {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="mb-4 font-heading text-lg font-bold text-white">{footer?.transparencyTitle}</h3>
        <ul class="space-y-2 text-sm">
          {footer?.transparency.map((link) => (
            <li>
              <a href={link.url} class="inline-flex items-center gap-2 transition-colors hover:text-primary-400">
                <i class="fas fa-chevron-right text-[10px] text-primary-400"></i> {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-crai flex flex-col items-center justify-between gap-4 py-6 text-sm sm:flex-row">
      <p>{footer?.copyright}</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-primary-400">Aviso Legal</a>
        <a href="#" class="hover:text-primary-400">Política de Privacidad</a>
        <a href="#" class="hover:text-primary-400">Mapa del Sitio</a>
      </div>
    </div>
  </div>
</footer>
