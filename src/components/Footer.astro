---
import { getSiteConfig } from '../lib/content';

const config = await getSiteConfig();
const contact = config?.contact;
const social = config?.social;
const footer = config?.footer;
const siteName = config?.siteName ?? 'CRAI';
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-about">
        <h3>{siteName}</h3>
        <p>{footer?.description}</p>
        <ul class="footer-contact">
          <li><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {contact?.address}</li>
          <li><i class="fas fa-phone" aria-hidden="true"></i> {contact?.phone}</li>
          <li><i class="fas fa-envelope" aria-hidden="true"></i> {contact?.email}</li>
        </ul>
        <div class="footer-social">
          {social && Object.entries(social).filter(([, v]) => v).map(([key, url]) => (
            <a href={url} aria-label={key}>
              <i class={`fab ${key === 'facebook' ? 'fa-facebook-f' : key === 'linkedin' ? 'fa-linkedin-in' : `fa-${key}`}`}></i>
            </a>
          ))}
        </div>
      </div>

      <div class="footer-col">
        <h3>{footer?.quickLinksTitle}</h3>
        <ul class="footer-links">
          {footer?.quickLinks.map((link) => (
            <li><a href={link.url}><i class="fas fa-chevron-right" aria-hidden="true"></i> {link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h3>{footer?.servicesTitle}</h3>
        <ul class="footer-links">
          {footer?.services.map((link) => (
            <li><a href={link.url}><i class="fas fa-chevron-right" aria-hidden="true"></i> {link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h3>{footer?.transparencyTitle}</h3>
        <ul class="footer-links">
          {footer?.transparency.map((link) => (
            <li><a href={link.url}><i class="fas fa-chevron-right" aria-hidden="true"></i> {link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>{footer?.copyright}</p>
      <div class="footer-bottom-links">
        <a href="#">Aviso Legal</a>
        <a href="#">Política de Privacidad</a>
        <a href="#">Mapa del Sitio</a>
      </div>
    </div>
  </div>
</footer>
