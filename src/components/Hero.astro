---
interface Props {
  stats: { value: number; suffix: string; label: string }[];
}
const { stats } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary-700 via-primary-600 to-primary-800 text-white">
  <div class="hero-pattern absolute inset-0 opacity-20" aria-hidden="true"></div>
  <div class="container-crai relative py-20 sm:py-28">
    <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-semibold backdrop-blur">
      <i class="fas fa-flask"></i> Conocimiento que transforma la sociedad
    </span>
    <h1 class="mt-6 max-w-3xl font-heading text-4xl font-extrabold leading-tight sm:text-5xl md:text-6xl">
      Centro de Recursos <br /><span class="text-secondary-300">para la Investigación y el Aprendizaje</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-white/80">
      Accede a recursos académicos, tecnología de vanguardia y apoyo especializado para potenciar tu investigación y formación.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/estudios" class="btn btn-primary btn-lg bg-white !text-primary-600 hover:!bg-white/90"><i class="fas fa-graduation-cap"></i> Explora Programas</a>
      <a href="/investigacion" class="btn btn-outline btn-lg"><i class="fas fa-flask"></i> Investigación</a>
    </div>
    <p class="mt-6 text-sm text-white/70"><i class="fas fa-search mr-2"></i>Busca en 8,000+ recursos académicos</p>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {stats.map((s) => (
        <div class="rounded-xl bg-white/10 p-4 text-center backdrop-blur">
          <i class="fas fa-users mb-2 text-2xl text-secondary-300"></i>
          <div class="font-heading text-3xl font-extrabold">
            <span data-count={s.value}>0</span>{s.suffix}
          </div>
          <div class="mt-1 text-sm text-white/80">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-pattern {
    background-image:
      radial-gradient(circle at 20% 30%, rgba(255,255,255,0.1) 8px, transparent 8px),
      radial-gradient(circle at 70% 60%, rgba(255,255,255,0.08) 6px, transparent 6px),
      radial-gradient(circle at 45% 85%, rgba(255,255,255,0.1) 10px, transparent 10px);
    background-size: 180px 180px;
  }
</style>
