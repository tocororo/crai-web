---
import { getSiteConfig, isPageEnabled } from '../lib/content';
import { getCollection } from 'astro:content';

const config = await getSiteConfig();
const nav = (config?.navigation ?? [])
  .filter((item) => isPageEnabled(config, item.url))
  .map((item) => ({
    ...item,
    children: item.children?.filter((child) => isPageEnabled(config, child.url)),
  }));
const logo = config?.logo;
const siteName = config?.siteName ?? 'CRAI';
const siteSubtitle = config?.siteSubtitle ?? '';
const { currentPath = '' } = Astro.props;

const yearLabels: Record<number, string> = {
  1: '1er año', 2: '2do año', 3: '3er año', 4: '4to año', 5: '5to año',
};

// Índice que alimenta el buscador del encabezado: las 34 materias de la carrera.
const materias = (await getCollection('materias-licenciatura'))
  .sort((a, b) => (a.data.año ?? 0) - (b.data.año ?? 0) || (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((m) => ({
    title: m.data.materia,
    meta: `${m.data.disciplina} · ${yearLabels[m.data.año] ?? m.data.año + '° año'} · ${m.data.horas} hrs`,
    keywords: m.data.descripcion ?? '',
    url: `/estudios?q=${encodeURIComponent(m.data.materia)}`,
  }));

// "<" se escapa para que un contenido con "</script>" no corte el bloque JSON
const materiasJson = JSON.stringify(materias).replace(/</g, '\\u003c');

const pathWithoutHash = currentPath.split('#')[0].replace(/\/$/, '') || '/';
const isActive = (url: string) => {
  const u = url.split('#')[0].replace(/\/$/, '') || '/';
  return pathWithoutHash === u;
};
const hasChildrenActive = (item: { url: string; children?: { url: string }[] }) => {
  if (isActive(item.url)) return true;
  return (item.children ?? []).some((c) => isActive(c.url));
};
---

<header class="header" role="banner">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="CRAI - Inicio">
      <div class="logo-img" aria-hidden="true">{logo && <img src={logo} alt="Logo CRAI" />}</div>
      <div class="logo-text">
        {siteName}
        <span>{siteSubtitle}</span>
      </div>
    </a>

    <nav class="nav" role="navigation" aria-label="Navegación principal">
      <ul class="nav-list" id="nav-list" role="menubar">
        {nav.map((item) => (
          <li
            role="none"
            class:list={[{ 'has-dropdown': item.children?.length }, { active: hasChildrenActive(item) }]}
          >
            <a href={item.url} role="menuitem">
              {item.label}
              {item.children && <i class="fas fa-chevron-down dropdown-arrow" aria-hidden="true"></i>}
            </a>
            {item.children && (
              <ul class="dropdown" role="menu">
                {item.children.map((child) => (
                  <li role="none"><a href={child.url} role="menuitem">{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="search-toggle" id="search-toggle" aria-label="Abrir buscador" aria-expanded="false">
        <i class="fas fa-search"></i>
      </button>
      <button class="menu-toggle" id="menu-toggle" aria-label="Abrir menú de navegación" aria-expanded="false">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </div>

  <!-- Search Bar -->
  <div class="search-bar" id="search-bar" role="search" aria-label="Buscador del sitio">
    <div class="container">
      <i class="fas fa-search search-icon" id="search-icon" aria-hidden="true"></i>
      <input type="search" id="search-input" placeholder="Buscar en el sitio..." aria-label="Buscar" autocomplete="off" spellcheck="false" />
      <button class="search-clear" id="search-clear" aria-label="Limpiar búsqueda">
        <i class="fas fa-times" aria-hidden="true"></i>
      </button>
    </div>
    <div class="search-hint">
      <span>Busca <strong>páginas y materias</strong> del CRAI</span>
    </div>
    <div class="search-results" id="search-results"></div>
  </div>

  <script type="application/json" id="materias-index" set:html={materiasJson}></script>
</header>
