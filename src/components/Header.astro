---
import { getSiteConfig } from '../lib/content';

const config = await getSiteConfig();
const nav = config?.navigation ?? [];
const logo = config?.logo;
const siteName = config?.siteName ?? 'CRAI';
const siteSubtitle = config?.siteSubtitle ?? '';
const { currentPath = '' } = Astro.props;

const pathWithoutHash = currentPath.split('#')[0].replace(/\/$/, '') || '/';
const isActive = (url: string) => {
  const u = url.split('#')[0].replace(/\/$/, '') || '/';
  return pathWithoutHash === u;
};
const hasChildrenActive = (item: { url: string; children?: { url: string }[] }) => {
  if (isActive(item.url)) return true;
  return (item.children ?? []).some((c) => isActive(c.url));
};
---

<header class="header" role="banner">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="CRAI - Inicio">
      <div class="logo-img" aria-hidden="true">{logo && <img src={logo} alt="Logo CRAI" />}</div>
      <div class="logo-text">
        {siteName}
        <span>{siteSubtitle}</span>
      </div>
    </a>

    <nav class="nav" role="navigation" aria-label="Navegación principal">
      <ul class="nav-list" id="nav-list" role="menubar">
        {nav.map((item) => (
          <li
            role="none"
            class:list={[{ 'has-dropdown': item.children?.length }, { active: hasChildrenActive(item) }]}
          >
            <a href={item.url} role="menuitem">
              {item.label}
              {item.children && <i class="fas fa-chevron-down dropdown-arrow" aria-hidden="true"></i>}
            </a>
            {item.children && (
              <ul class="dropdown" role="menu">
                {item.children.map((child) => (
                  <li role="none"><a href={child.url} role="menuitem">{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="search-toggle" id="search-toggle" aria-label="Abrir buscador" aria-expanded="false">
        <i class="fas fa-search"></i>
      </button>
      <button class="theme-toggle" id="theme-toggle" aria-label="Cambiar modo claro/oscuro">
        <i class="fas fa-moon"></i>
      </button>
      <button class="menu-toggle" id="menu-toggle" aria-label="Abrir menú de navegación" aria-expanded="false">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </div>

  <!-- Search Bar -->
  <div class="search-bar" id="search-bar" role="search" aria-label="Buscador interno">
    <div class="container">
      <i class="fas fa-search search-icon" id="search-icon" aria-hidden="true"></i>
      <input type="search" id="search-input" placeholder="Buscar páginas, publicaciones científicas..." aria-label="Buscar" autocomplete="off" spellcheck="false" />
      <button class="search-clear" id="search-clear" aria-label="Limpiar búsqueda">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="search-hint">
      <span>Busca en <strong>páginas del CRAI</strong> y en el <strong>Repositorio Científico (RC)</strong></span>
    </div>
    <div class="search-results" id="search-results"></div>
  </div>
</header>
