---
export interface Props {
  title?: string;
  subtitle?: string;
  events: { day: string; month: string; location: string; time: string; title: string; featured?: boolean }[];
}
const { title = 'Próximos Eventos', subtitle = 'No te pierdas las actividades académicas, culturales y deportivas de nuestra comunidad', events = [] } = Astro.props;
---

<section class="section-crai" aria-labelledby="eventos-title">
  <div class="container-crai">
    <h2 class="section-title" id="eventos-title">{title}</h2>
    <div class="mx-auto my-4 h-1 w-20 rounded bg-secondary-400" aria-hidden="true"></div>
    <p class="section-subtitle">{subtitle}</p>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      {events.map((e) => (
        <article class="card-hover reveal flex items-center gap-5 rounded-xl border border-border bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
          <div class="flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-xl bg-primary-500 text-white">
            <span class="font-heading text-3xl font-extrabold leading-none">{e.day}</span>
            <span class="text-sm font-semibold uppercase">{e.month}</span>
          </div>
          <div class="min-w-0">
            <h4 class="font-heading text-lg font-bold text-text dark:text-white">
              {String(e.title)}
            </h4>
            <p class="mt-1 text-sm text-text-secondary dark:text-gray-300"><i class="fas fa-map-marker-alt mr-2 text-primary-500"></i>{e.location}</p>
            <p class="text-sm text-text-secondary dark:text-gray-300"><i class="fas fa-clock mr-2 text-primary-500"></i>{e.time}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
