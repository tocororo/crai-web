---
interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  light?: boolean;
  className?: string;
}
const { id, title, subtitle, light = false, className = '' } = Astro.props;
---

<section id={id} class={`section-crai ${light ? 'bg-surface-2 dark:bg-slate-800/40' : ''} ${className}`} aria-labelledby={`${id}-title`}>
  <div class="container-crai">
    <h2 class="section-title" id={`${id}-title`}>{title}</h2>
    <div class="mx-auto my-4 h-1 w-20 rounded bg-secondary-400" aria-hidden="true"></div>
    {subtitle && <p class="section-subtitle">{subtitle}</p>}
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
