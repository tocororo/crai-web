---
interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  light?: boolean;
  style?: string;
}
const { id, title, subtitle, light = false, style } = Astro.props;
const inlineStyle = light && !style ? 'background: var(--bg-light);' : (style ?? '');
---

<section id={id} class="section" aria-labelledby={`${id ?? 'section'}-title`} style={inlineStyle || undefined}>
  <div class="container">
    <h2 class="section-title" id={`${id ?? 'section'}-title`}>{title}</h2>
    <div class="section-divider" aria-hidden="true"></div>
    {subtitle && <p class="section-subtitle">{subtitle}</p>}
    <slot />
  </div>
</section>
