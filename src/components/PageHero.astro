---
interface Props {
  badgeIcon?: string;
  badgeImg?: string;
  badge?: string;
  title: string;
  subtitle?: string;
  crumb: string;
  parentLabel?: string;
  parentUrl?: string;
}
const { badgeIcon = 'fa-university', badgeImg, badge = 'Centro de Recursos', title, subtitle, crumb, parentLabel = 'Inicio', parentUrl = '/' } = Astro.props;
---

<section class="hero hero--compact" aria-label={title}>
  <div class="hero-bg hero-bg--plain"></div>
  <div class="hero-overlay"></div>
  <div class="hero-symbols" aria-hidden="true">
    <img src="/images/upr/icon-book.svg" class="hero-symbol hs-book" alt="" />
    <img src="/images/upr/icon-graduation.svg" class="hero-symbol hs-graduation" alt="" />
    <img src="/images/upr/icon-search.svg" class="hero-symbol hs-search" alt="" />
    <img src="/images/upr/icon-lightbulb.svg" class="hero-symbol hs-lightbulb" alt="" />
    <img src="/images/upr/icon-atom.svg" class="hero-symbol hs-atom" alt="" />
    <img src="/images/upr/icon-potion.svg" class="hero-symbol hs-potion" alt="" />
    <img src="/images/upr/icon-pencil.svg" class="hero-symbol hs-pencil" alt="" />
    <img src="/images/upr/icon-brain.svg" class="hero-symbol hs-brain" alt="" />
    <img src="/images/upr/icon-globe.svg" class="hero-symbol hs-globe" alt="" />
    <img src="/images/upr/icon-calculator.svg" class="hero-symbol hs-calculator" alt="" />
    <img src="/images/upr/icon-microscope.svg" class="hero-symbol hs-microscope" alt="" />
    <img src="/images/upr/icon-dna.svg" class="hero-symbol hs-dna" alt="" />
  </div>
  <div class="hero-particles" aria-hidden="true">
    <div class="hero-particle" style="--x:15%;--y:20%;--s:60px;--d:0s;"></div>
    <div class="hero-particle" style="--x:80%;--y:30%;--s:40px;--d:2s;"></div>
    <div class="hero-particle" style="--x:25%;--y:70%;--s:50px;--d:4s;"></div>
    <div class="hero-particle" style="--x:70%;--y:65%;--s:35px;--d:1s;"></div>
    <div class="hero-particle" style="--x:50%;--y:15%;--s:45px;--d:3s;"></div>
    <div class="hero-particle" style="--x:10%;--y:50%;--s:30px;--d:5s;"></div>
    <div class="hero-particle" style="--x:90%;--y:55%;--s:55px;--d:2.5s;"></div>
    <div class="hero-particle" style="--x:45%;--y:85%;--s:25px;--d:4.5s;"></div>
  </div>
  <div class="hero-content">
    {badge ? (
      <div class="hero-badge-wrapper">
        <span class="hero-badge">
          {badgeImg ? (
            <img class="univ-hero-logo" src={badgeImg} alt="" aria-hidden="true" />
          ) : (
            <i class={`fas ${badgeIcon}`} aria-hidden="true"></i>
          )}
          {badge}
        </span>
      </div>
    ) : null}
    <h1 class="hero-title univ-hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
  </div>
</section>

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ul>
      <li><a href={parentUrl}>{parentLabel}</a></li>
      <li class="current" aria-current="page">{crumb}</li>
    </ul>
  </div>
</nav>