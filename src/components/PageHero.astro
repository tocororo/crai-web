---
interface Props {
  badgeIcon?: string;
  badge?: string;
  title: string;
  subtitle?: string;
  crumb: string;
  parentLabel?: string;
  parentUrl?: string;
}
const { badgeIcon = 'fa-university', badge = 'Centro de Recursos', title, subtitle, crumb, parentLabel = 'Inicio', parentUrl = '/' } = Astro.props;
---

<section class="page-hero" aria-label={title}>
  <div class="container">
  {badge ? (
    <span class="page-hero-badge"><i class={`fas ${badgeIcon}`} aria-hidden="true"></i> {badge}</span>
  ) : null}
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</section>

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ul>
      <li><a href={parentUrl}>{parentLabel}</a></li>
      <li class="current" aria-current="page">{crumb}</li>
    </ul>
  </div>
</nav>
