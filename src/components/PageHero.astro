---
interface Props {
  badgeIcon?: string;
  badgeImg?: string;
  badge?: string;
  title: string;
  subtitle?: string;
  crumb: string;
  parentLabel?: string;
  parentUrl?: string;
  bgImage?: string;
}
const { badgeIcon = 'fa-university', badgeImg, badge = 'Centro de Recursos', title, subtitle, crumb, parentLabel = 'Inicio', parentUrl = '/', bgImage } = Astro.props;
---

<section class={`hero hero--compact${bgImage ? ' hero--photo' : ''}`} aria-label={title}>
  {bgImage ? (
    <div
      class="hero-bg"
      style={`background-image: url('${bgImage}'); background-color: #012D17;`}
    ></div>
  ) : (
    <div class="hero-bg hero-bg--plain"></div>
  )}
  <div class="hero-overlay"></div>
  <div class="hero-content">
    {badge ? (
      <div class="hero-badge-wrapper">
        <span class="hero-badge">
          {badgeImg ? (
            <img class="univ-hero-logo" src={badgeImg} alt="" aria-hidden="true" />
          ) : (
            <i class={`fas ${badgeIcon}`} aria-hidden="true"></i>
          )}
          {badge}
        </span>
      </div>
    ) : null}
    <h1 class="hero-title univ-hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
  </div>
</section>

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ul>
      <li><a href={parentUrl}>{parentLabel}</a></li>
      <li class="current" aria-current="page">{crumb}</li>
    </ul>
  </div>
</nav>
