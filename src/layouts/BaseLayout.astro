---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteConfig } from '../lib/content';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'CRAI - Centro de Recursos para el Aprendizaje y la Investigación' } = Astro.props;

const currentPath = Astro.url.pathname;
const hasAdmin = currentPath.startsWith('/admin');

const siteConfig = await getSiteConfig();
const cookiesConfig = siteConfig?.cookies;
const cookiesEnabled = cookiesConfig?.enabled ?? true;
const cookiesMessage = cookiesConfig?.message ?? 'Este sitio utiliza cookies para mejorar tu experiencia. Al continuar navegando aceptas nuestra';
const cookiesAcceptLabel = cookiesConfig?.acceptLabel ?? 'Aceptar';
const cookiesDeclineLabel = cookiesConfig?.declineLabel ?? 'Rechazar';
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/images/305464304_448374310649340_2984277522454001566_n-Photoroom.png" />
  <link rel="stylesheet" href="/css/all.min.css" />
  <link rel="stylesheet" href="/css/leaflet.css" />
</head>
<body>
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  <div class="loading-overlay" id="loading-overlay">
    <div class="loading-spinner"></div>
  </div>

  {!hasAdmin && <Header currentPath={currentPath} />}

  <main id="main-content">
    <slot />
  </main>

  {!hasAdmin && <Footer />}
  {!hasAdmin && (
    <button class="back-to-top" id="back-to-top" aria-label="Volver arriba">
      <i class="fas fa-arrow-up" aria-hidden="true"></i>
    </button>
  )}

  {!hasAdmin && cookiesEnabled && (
    <div class="cookie-consent" id="cookie-consent">
      <div class="container">
        <p>{cookiesMessage} <a href="#">política de cookies</a>.</p>
        <div class="cookie-buttons">
          <button class="btn btn-primary" id="cookie-accept">{cookiesAcceptLabel}</button>
          <button class="btn btn-secondary" id="cookie-decline">{cookiesDeclineLabel}</button>
        </div>
      </div>
    </div>
  )}

  {!hasAdmin && (
    <script>
      import '../scripts/main.js';
    </script>
  )}
  <script is:inline src="/js/leaflet.js"></script>
</body>
</html>
