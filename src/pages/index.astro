---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIcons from '../components/SectionIcons.astro';
import { getCollection } from 'astro:content';
import { formatDate, getSiteConfig, slugify } from '../lib/content';

const config = await getSiteConfig();
const noticias = (await getCollection('noticias', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const eventos = (await getCollection('eventos')).filter((e) => e.data.featured).slice(0, 3);
const estadisticas = (await getCollection('estadisticas')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const buscadores = (await getCollection('buscadores')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const engineItems = buscadores.flatMap((c) => c.data.items);
const estadisticasVisibles = estadisticas.filter((s) => s.data.value !== 0);
const totalEstadisticasVisibles = estadisticasVisibles.length;
---

<BaseLayout title={`${config?.siteName ?? 'CRAI'} - Centro de Recursos para el Aprendizaje y la Investigación`} description={config?.description}>
  <!-- HERO -->
  <section class="hero" aria-label="Bienvenida">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-symbols" aria-hidden="true">
      <img src="/images/upr/icon-book.svg" class="hero-symbol hs-book" alt="" />
      <img src="/images/upr/icon-graduation.svg" class="hero-symbol hs-graduation" alt="" />
      <img src="/images/upr/icon-search.svg" class="hero-symbol hs-search" alt="" />
      <img src="/images/upr/icon-lightbulb.svg" class="hero-symbol hs-lightbulb" alt="" />
      <img src="/images/upr/icon-atom.svg" class="hero-symbol hs-atom" alt="" />
      <img src="/images/upr/icon-potion.svg" class="hero-symbol hs-potion" alt="" />
      <img src="/images/upr/icon-pencil.svg" class="hero-symbol hs-pencil" alt="" />
      <img src="/images/upr/icon-brain.svg" class="hero-symbol hs-brain" alt="" />
      <img src="/images/upr/icon-globe.svg" class="hero-symbol hs-globe" alt="" />
      <img src="/images/upr/icon-calculator.svg" class="hero-symbol hs-calculator" alt="" />
      <img src="/images/upr/icon-microscope.svg" class="hero-symbol hs-microscope" alt="" />
      <img src="/images/upr/icon-dna.svg" class="hero-symbol hs-dna" alt="" />
    </div>
    <div class="hero-particles" aria-hidden="true">
      <div class="hero-particle" style="--x:15%;--y:20%;--s:60px;--d:0s;"></div>
      <div class="hero-particle" style="--x:80%;--y:30%;--s:40px;--d:2s;"></div>
      <div class="hero-particle" style="--x:25%;--y:70%;--s:50px;--d:4s;"></div>
      <div class="hero-particle" style="--x:70%;--y:65%;--s:35px;--d:1s;"></div>
      <div class="hero-particle" style="--x:50%;--y:15%;--s:45px;--d:3s;"></div>
      <div class="hero-particle" style="--x:10%;--y:50%;--s:30px;--d:5s;"></div>
      <div class="hero-particle" style="--x:90%;--y:55%;--s:55px;--d:2.5s;"></div>
      <div class="hero-particle" style="--x:45%;--y:85%;--s:25px;--d:4.5s;"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge-wrapper">
        <span class="hero-badge"><i class="fas fa-flask"></i> Conocimiento que transforma la sociedad</span>
      </div>
      <h1 class="hero-title">Centro de Recursos <br><span class="hero-title-accent">para el Aprendizaje y la Investigación</span></h1>
      <p class="hero-subtitle">Accede a recursos académicos, tecnología de vanguardia y apoyo especializado para potenciar tu investigación y formación.</p>
      <div class="hero-actions">
        <a href="/estudios" class="btn btn-primary btn-lg"><i class="fas fa-graduation-cap"></i> Explora Programas</a>
        <a href="/investigacion" class="btn btn-outline btn-lg"><i class="fas fa-flask"></i> Investigación</a>
      </div>
    </div>
    {totalEstadisticasVisibles > 0 && (
      <div class="hero-stats" aria-label="Estadísticas institucionales" style={{gridTemplateColumns: `repeat(${totalEstadisticasVisibles}, 1fr)`}}>
        {estadisticasVisibles.map((s) => (
          <div class="hero-stat">
            <div class="hero-stat-icon"><i class="fas fa-chart-line"></i></div>
            <span class="hero-stat-number" data-target={s.data.value}>0</span>
            <span class="hero-stat-label">{s.data.label}</span>
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- NOTICIAS - CARRUSEL -->
  <section class="section" aria-labelledby="noticias-title">
    <SectionIcons icons={['fa-bullhorn', 'fa-calendar-days', 'fa-bell']} />
    <div class="container">
      <span class="section-eyebrow">Actualidad</span>
      <h2 class="section-title" id="noticias-title">Últimas Noticias</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Lo último que ocurre en nuestra comunidad universitaria</p>
      <div class="carousel" id="news-carousel">
        <div class="carousel-progress" aria-hidden="true"></div>
        <div class="carousel-track" id="news-track">
          {noticias.map((n) => (
            <div class="carousel-slide">
              <article class="news-card">
                <div class="news-card-img">
                  {n.data.heroImage ? (
                    <img src={n.data.heroImage} alt={n.data.title} loading="lazy" />
                  ) : (
                    <i class={n.data.icon ?? 'fas fa-newspaper'} aria-hidden="true"></i>
                  )}
                  <span class="date-badge">{formatDate(n.data.pubDate)}</span>
                </div>
                <div class="news-card-body">
                  <h3><a href={`/actualidad/${n.id}`}>{n.data.title}</a></h3>
                  <p>{n.data.description}</p>
                  <a href={`/actualidad/${n.id}`} class="read-more">Leer más <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                </div>
              </article>
            </div>
          ))}
        </div>
        <button class="carousel-btn carousel-prev" id="news-prev" aria-label="Noticia anterior">
          <i class="fas fa-chevron-left" aria-hidden="true"></i>
        </button>
        <button class="carousel-btn carousel-next" id="news-next" aria-label="Noticia siguiente">
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </button>
        <div class="carousel-dots" id="news-dots"></div>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="section" style="background: var(--bg-light);" aria-labelledby="servicios-title">
    <SectionIcons icons={['fa-book-open', 'fa-cloud', 'fa-box-archive']} align="left" />
    <div class="container">
      <span class="section-eyebrow">Acceso</span>
      <h2 class="section-title" id="servicios-title">Servicios CRAI</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Puertas de entrada a nuestros recursos académicos y digitales</p>
      <div class="services-grid">
        {(config?.footer?.services ?? []).map((s, i) => (
          <a href={s.url} class="service-card reveal" target="_blank" rel="noopener noreferrer">
            <span class="service-card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="service-card-icon"><i class={s.icon ?? 'fas fa-arrow-right'} aria-hidden="true"></i></span>
            <h3 class="service-card-title">{s.label}</h3>
            <p class="service-card-url">{s.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</p>
            <span class="service-card-go">
              Acceder
              <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BUSCADORES Y REPOSITORIOS -->
  <section class="section home-engines" aria-labelledby="home-engines-title">
    <SectionIcons icons={['fa-magnifying-glass', 'fa-database', 'fa-book-open-reader']} align="left" />
    <div class="container">
      <span class="section-eyebrow">Investigación</span>
      <h2 class="section-title" id="home-engines-title">Buscadores y repositorios recomendados</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Bases de datos, portales de acceso abierto y repositorios seleccionados por el CRAI para encontrar literatura científica y fuentes confiables.</p>

      <div class="home-engines-grid">
        {engineItems.map((it) => (
          <a
            class="home-engine-tile"
            href={`/estudios#engine-${slugify(it.name)}`}
            title={it.name}
            aria-label={`Ver ${it.name} en buscadores de investigación`}
          >
            {it.logo ? (
              <img src={it.logo} alt="" loading="lazy" decoding="async" />
            ) : (
              <span class="home-engine-monogram" aria-hidden="true">{it.name.charAt(0)}</span>
            )}
          </a>
        ))}
      </div>

      <div class="home-engines-cta">
        <div class="home-engines-stats">
          <span class="home-engines-stat"><strong>{engineItems.length}</strong> buscadores</span>
          <span class="home-engines-dot" aria-hidden="true"></span>
          <span class="home-engines-stat"><strong>{buscadores.length}</strong> categorías</span>
          <span class="home-engines-dot" aria-hidden="true"></span>
          <span class="home-engines-stat">consejos de búsqueda</span>
        </div>
        <a href="/estudios#buscadores" class="btn btn-primary btn-lg">
          <i class="fas fa-magnifying-glass-chart" aria-hidden="true"></i> Explorar buscadores
        </a>
      </div>
    </div>
  </section>

  <!-- DATOS RÁPIDOS -->
  <section class="stats-section" aria-labelledby="stats-title">
    <SectionIcons icons={['fa-chart-line', 'fa-chart-bar', 'fa-chart-pie']} align="left" />
    <div class="container">
      <span class="section-eyebrow section-eyebrow--light">Impacto</span>
      <h2 class="section-title section-title--light" id="stats-title">El CRAI en Cifras</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Más de cinco décadas formando profesionales que transforman el mundo</p>
      <div class="stats-grid">
        {estadisticasVisibles.map((s) => (
          <div class="stat-item reveal">
            <span class="stat-number" data-target={s.data.value}>0</span><span class="stat-plus">{s.data.suffix}</span>
            <span class="stat-label">{s.data.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EVENTOS -->
  <section class="section" aria-labelledby="eventos-title">
    <SectionIcons icons={['fa-calendar-days', 'fa-bullhorn', 'fa-calendar-check']} align="left" />
    <div class="container">
      <span class="section-eyebrow">Agenda</span>
      <h2 class="section-title" id="eventos-title">Próximos Eventos</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Actividades académicas, culturales y deportivas de nuestra comunidad</p>
      <div class="events-grid">
        {eventos.map((e, i) => (
          <div class="event-card reveal">
            <div class="event-date">
              <span class="day">{e.data.day}</span>
              <span class="month">{e.data.month}</span>
            </div>
            <div class="event-info">
              <span class="event-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h4>{e.data.title}</h4>
              <p><i class="fas fa-location-dot" aria-hidden="true"></i> {e.data.location}</p>
              <p><i class="fas fa-clock" aria-hidden="true"></i> {e.data.time}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
