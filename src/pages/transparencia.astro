---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionIcons from '../components/SectionIcons.astro';
import { getCollection } from 'astro:content';

const byOrder = (a: { data: { order?: number } }, b: { data: { order?: number } }) => (a.data.order ?? 0) - (b.data.order ?? 0);

const stats = (await getCollection('estadisticas')).sort(byOrder);
const informes = (await getCollection('informes')).sort(byOrder);
const normativas = (await getCollection('normativas')).sort(byOrder);
const datosAbiertos = (await getCollection('datos-abiertos')).sort(byOrder);
---

<BaseLayout title="Transparencia – CRAI" description="Portal de Transparencia del CRAI. Accede a informes financieros, normativas, datos abiertos y estadísticas institucionales.">
  <PageHero
    badgeIcon="fa-balance-scale"
    badge="Rendición de Cuentas"
    title="Transparencia Institucional"
    subtitle="Compromiso con la rendición de cuentas y el acceso a la información"
    crumb="Portal de Transparencia"
    bgImage="/images/hero-transparencia.jpg"
  />

  <!-- Informes -->
  <section class="section" aria-labelledby="informes-title">
    <SectionIcons icons={['fa-box-archive', 'fa-file-lines', 'fa-cloud-arrow-up']} />
    <div class="container">
      <h2 class="section-title" id="informes-title">Informes Institucionales</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Accede a nuestros informes oficiales y documentos de gestión institucional</p>
      <div class="reports-grid">
        {informes.map((inf) => (
          <div class="report-item reveal">
            <div class="report-info">
              <h4><i class={inf.data.icon} aria-hidden="true"></i> {inf.data.title}</h4>
              <p>{inf.data.desc}</p>
            </div>
            <a
              href={inf.data.file || '#'}
              class="report-download"
              aria-label={`Descargar ${inf.data.title}`}
              download={inf.data.file ? true : undefined}
            ><i class="fas fa-download"></i> Descargar</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Normativas y Políticas -->
  <section id="normativas" class="section" style="background: var(--bg-light);" aria-labelledby="normativas-title">
    <SectionIcons icons={['fa-gavel', 'fa-scale-balanced', 'fa-file-contract']} align="left" />
    <div class="container">
      <h2 class="section-title" id="normativas-title">Normativas y Políticas</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Marco normativo y políticas institucionales que rigen nuestra actividad universitaria</p>
      <div class="content-grid">
        {normativas.map((n) => (
          <div class="content-card reveal">
            <div class="content-card-icon"><i class={n.data.icon}></i></div>
            <h3>{n.data.title}</h3>
            <p>{n.data.desc}</p>
            {n.data.file ? (
              <a href={n.data.file} class="read-more" download><i class="fas fa-download" aria-hidden="true"></i> Descargar</a>
            ) : (
              <a href="#" class="read-more">Consultar <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Estadísticas Institucionales -->
  <section id="estadisticas" class="stats-section" aria-labelledby="estadisticas-title">
    <SectionIcons icons={['fa-chart-line', 'fa-chart-bar', 'fa-chart-pie']} align="left" />
    <div class="container">
      <h2 class="section-title section-title--light" id="estadisticas-title">Estadísticas Institucionales</h2>
      <div class="section-divider" style="background: var(--secondary);" aria-hidden="true"></div>
      <p class="section-subtitle" style="color: rgba(255,255,255,0.8);">Datos actualizados que reflejan nuestra dimensión y alcance institucional</p>
      <div class="stats-grid">
        {stats.map((s) => (
          <div class="stat-item reveal">
            <span class="stat-number" data-target={s.data.value}>0</span><span class="stat-plus">{s.data.suffix}</span>
            <span class="stat-label">{s.data.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
