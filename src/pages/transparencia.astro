---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';

const stats = (await getCollection('estadisticas')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const informes = [
  { icon: 'fas fa-file-alt', title: 'Informe Anual 2025', desc: 'Memoria completa de actividades, logros académicos, financieros y de gestión correspondiente al ejercicio 2025.' },
  { icon: 'fas fa-chart-bar', title: 'Informe Financiero Q1 2026', desc: 'Reporte trimestral detallado de ingresos, egresos, ejecución presupuestaria y proyecciones financieras.' },
  { icon: 'fas fa-tasks', title: 'Informe de Gestión', desc: 'Detalle de la gestión administrativa, indicadores de desempeño y cumplimiento de objetivos estratégicos.' },
  { icon: 'fas fa-road', title: 'Plan Estratégico 2025-2030', desc: 'Hoja de ruta institucional con objetivos, metas e iniciativas estratégicas para los próximos cinco años.' },
];

const normativas = [
  { icon: 'fas fa-gavel', title: 'Estatuto Universitario', desc: 'Documento fundamental que establece la estructura, gobierno y funcionamiento de la Universidad.' },
  { icon: 'fas fa-shield-alt', title: 'Política de Calidad', desc: 'Marco de aseguramiento de la calidad académica y administrativa para la mejora continua institucional.' },
  { icon: 'fas fa-balance-scale', title: 'Código de Ética', desc: 'Principios y valores que guían la conducta de todos los miembros de la comunidad universitaria.' },
  { icon: 'fas fa-file-contract', title: 'Reglamento Académico', desc: 'Normas que regulan los procesos de admisión, matrícula, evaluación, titulación y demás aspectos académicos.' },
  { icon: 'fas fa-users', title: 'Política de Equidad e Inclusión', desc: 'Compromiso institucional con la igualdad de oportunidades, la diversidad y la no discriminación.' },
  { icon: 'fas fa-leaf', title: 'Política Ambiental', desc: 'Lineamientos para la gestión ambiental sostenible y la responsabilidad ecológica institucional.' },
];

const datosAbiertos = [
  { icon: 'fas fa-database', title: 'Catálogo de Datos', desc: 'Explora nuestro catálogo de conjuntos de datos abiertos sobre indicadores académicos, financieros y de gestión disponibles en formatos reutilizables.' },
  { icon: 'fas fa-code-branch', title: 'API de Datos Abiertos', desc: 'Accede a nuestra API pública para consultar datos institucionales de forma programática con documentación completa y ejemplos de uso.' },
  { icon: 'fas fa-chart-pie', title: 'Visualizaciones', desc: 'Dashboards interactivos con visualizaciones dinámicas de los principales indicadores institucionales actualizados en tiempo real.' },
  { icon: 'fas fa-license', title: 'Licencias y Condiciones', desc: 'Los datos abiertos de la Universidad se publican bajo licencia Creative Commons Attribution 4.0 International.' },
];

const declaraciones = [
  { icon: 'fas fa-user-tie', title: 'Rectoría', desc: 'Declaraciones patrimoniales y de intereses del Rector y Vicerrectores de la Universidad del Futuro.' },
  { icon: 'fas fa-users-cog', title: 'Consejo Universitario', desc: 'Declaraciones de los miembros del máximo órgano de gobierno colegiado de la institución.' },
  { icon: 'fas fa-chalkboard-teacher', title: 'Decanos y Directores', desc: 'Declaraciones patrimoniales de Decanos de Facultades y Directores de Escuelas y Departamentos.' },
  { icon: 'fas fa-file-invoice', title: 'Procedimiento de Acceso', desc: 'Conoce el procedimiento para solicitar acceso a las declaraciones de bienes conforme a la legislación vigente.' },
];
---

<BaseLayout title="Transparencia – CRAI" description="Portal de Transparencia del CRAI. Accede a informes financieros, normativas, datos abiertos y estadísticas institucionales.">
  <PageHero
    badgeIcon="fa-balance-scale"
    badge="Rendición de Cuentas"
    title="Transparencia Institucional"
    subtitle="Compromiso con la rendición de cuentas y el acceso a la información"
    crumb="Portal de Transparencia"
  />

  <!-- Informes -->
  <section class="section" aria-labelledby="informes-title">
    <div class="container">
      <h2 class="section-title" id="informes-title">Informes Institucionales</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Accede a nuestros informes oficiales y documentos de gestión institucional</p>
      <div class="reports-grid">
        {informes.map((inf) => (
          <div class="report-item reveal">
            <div class="report-info">
              <h4><i class={inf.icon} aria-hidden="true"></i> {inf.title}</h4>
              <p>{inf.desc}</p>
            </div>
            <a href="#" class="report-download" aria-label={`Descargar ${inf.title}`}><i class="fas fa-download"></i> Descargar</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Normativas y Políticas -->
  <section id="normativas" class="section" style="background: var(--bg-light);" aria-labelledby="normativas-title">
    <div class="container">
      <h2 class="section-title" id="normativas-title">Normativas y Políticas</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Marco normativo y políticas institucionales que rigen nuestra actividad universitaria</p>
      <div class="content-grid">
        {normativas.map((n) => (
          <div class="content-card reveal">
            <div class="content-card-icon"><i class={n.icon}></i></div>
            <h3>{n.title}</h3>
            <p>{n.desc}</p>
            <a href="#" class="read-more">Consultar <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Datos Abiertos -->
  <section id="datos" class="section" aria-labelledby="datos-title">
    <div class="container">
      <h2 class="section-title" id="datos-title">Datos Abiertos</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Información pública disponible para su reutilización y análisis</p>
      <div class="content-grid">
        {datosAbiertos.map((d) => (
          <div class="content-card reveal">
            <div class="content-card-icon"><i class={d.icon}></i></div>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center" style="margin-top: 2rem;">
        <a href="#" class="btn btn-gold"><i class="fas fa-download"></i> Acceder al Portal de Datos Abiertos</a>
      </div>
    </div>
  </section>

  <!-- Estadísticas Institucionales -->
  <section id="estadisticas" class="stats-section" aria-labelledby="estadisticas-title">
    <div class="container">
      <h2 class="section-title" style="color: var(--text-light);" id="estadisticas-title">Estadísticas Institucionales</h2>
      <div class="section-divider" style="background: var(--secondary);" aria-hidden="true"></div>
      <p class="section-subtitle" style="color: rgba(255,255,255,0.8);">Datos actualizados que reflejan nuestra dimensión y alcance institucional</p>
      <div class="stats-grid">
        {stats.map((s) => (
          <div class="stat-item reveal">
            <span class="stat-number" data-target={s.data.value}>0</span><span class="stat-plus">{s.data.suffix}</span>
            <span class="stat-label">{s.data.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Declaraciones de Bienes -->
  <section class="section" style="background: var(--bg-warm);" aria-labelledby="declaraciones-title">
    <div class="container">
      <h2 class="section-title" id="declaraciones-title">Declaraciones de Bienes</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Declaraciones patrimoniales y de intereses de las autoridades universitarias</p>
      <div class="content-grid">
        {declaraciones.map((d) => (
          <div class="content-card reveal">
            <div class="content-card-icon"><i class={d.icon}></i></div>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <a href="#" class="read-more">Ver declaraciones <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
