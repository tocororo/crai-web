---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const equipo = (await getCollection('equipo')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const timeline = [
  { year: '1972', title: 'Creación', desc: 'Creación de la Biblioteca Universitaria y de la Direccion de Información científico Técnico. Implementacion de los servicios básicos de información a la comunidad universitaria.'},
  { year: '1985', title: 'Creación de la Red de Bibliotecas', desc: 'Creación de la Red de Bibliotecas del Ministerio de Educación Superior.' },
  { year: '1986', title: 'Biblioteca y Tecnología', desc: 'Inicio la dotación de infraestructura tecnológica avanzada y la creación de nuevos servicios de información.' },
  { year: '1995', title: 'Inicio de la carrera de Bibliotecología y Ciencias de la Información', desc: 'Inicio de los estudios de la carrera de Bibliotecología y Ciencias de la Información a través del proceso de universalización.' },
  { year: '2002', title: 'Adquisición de Bases de Datos Bibliográficos', desc: 'Adquisición de las primeras bases de datos bibliográficos de Información.' },
  { year: '2005', title: 'Biblioteca en función de la docencia', desc: 'Creación del grupo PROGINTEC, a traves del proyecto para el desarrollo de tecnologías de la información. La biblioteca asume la función docente.' },
  { year: '2011', title: 'Creación de Servicios de la Sala Abierta', desc: 'Creación del servicio de sala abierta en el pasillo de la biblioteca Hermanos Saíz.' },
  { year: '2012', title: 'Primer Taller Internacional de Bibliotecas', desc: 'Celebración del primer taller internacional de Bibliotecas Digitales' },
  { year: '2015', title: 'Creación del CRAI', desc: 'Creación del Centro de Recursos para el Aprendizaje y la Investigación con la integración de las Bibliotecas Universitarias de la sede Nancy Urunga, Rafael M. Mendive y Hermanos Saíz. Creación del departamento Docente Ciencias de la Información.' },
  { year: '2017', title: 'Creación del Departamento de Sistema', desc: 'Creación del departamento de Sistema y Tecnologias de la Información. El departamento de publicaciones sale del CRAI para convertirse en Dirección Editorial.' },
];

const mvv = [
  { icon: 'fas fa-bullseye', title: 'Misión', desc: 'Contribuir en la transformación de la calidad y la pertinencia de los procesos sustantivos de la universidad, mediante el empleo intensivo de la información científico y tecnológica, servicios para el desempeño de actividades docentes de aprendizaje y de investigación, y como copartícipe en la formación continua de los egresados, tributando al fortalecimiento de la labor político ideológica con los profesores y estudiantes en la comunidad universitaria y su entorno social.' },
  { icon: 'fas fa-eye', title: 'Visión', desc: 'Ser el ecosistema inteligente y dinamizador del conocimiento en la universidad pinareña, reconocido por su excelencia, innovación y pertinencia social, donde la información científico-tecnológica se transforma en soluciones concretas para los desafíos del progreso sostenible de nuestro territorio.' },
  { icon: 'fas fa-heart', title: 'Valores', desc: 'Responsabilidad, Ética.' },
];

const organigrama = [
  { level: 1, nodes: ['Vicerrectoría'] },
  { level: 2, nodes: ['Dirección CRAI'] },
  {
    level: 3,
    nodes: [
      'Departamento Docente Ciencias de la Información',
      'Departamento de Sistema tecnologías de la Información',
      {
        label: 'Subdirección Bibliotecas',
        children: ['Biblioteca Hermanos Saíz', 'Biblioteca Nancy Uranga', 'Rafael M. Mendive'],
      },
    ],
  },
];

const campus = [
  { icon: 'fas fa-university', name: 'Dirección Biblioteca Hermanos Saiz Montes de Oca', desc: 'Calle José Martí No 300, Barrio Segundo Sur, e/27 de Noviembre y González Alcorta, Pinar del Río, Cuba.', geo: 'C878%2BQ4Q', default: true },
  { icon: 'fas fa-futbol', name: 'Dirección Biblioteca Nancy Uranga Romagoza', desc: 'Calle Capitán San Luis s/n, Pinar del Río, Cuba.', geo: 'C8C5%2BWFH' },
  { icon: 'fas fa-chalkboard-teacher', name: 'Dirección Biblioteca “Rafael María Mendive”', desc: 'Calle Los Pinos final, esquina avenida Borrego. Reparto Hermanos Cruz, Pinar del Río, Cuba.', geo: 'C8FF%2BVJM' },
  //{ icon: 'fas fa-globe-americas', name: 'Sede Internacional', desc: 'Calle del Saber 789, Distrito Internacional. Centro de posgrado y programas de cooperación global.' },
];

const acreditaciones = [
  { icon: 'fas fa-certificate', title: 'Acreditación Institucional', desc: 'Certificación de alta calidad otorgada por el Consejo Nacional de Acreditación, vigente hasta 2028.' },
  { icon: 'fas fa-trophy', title: 'Certificación ISO 9001', desc: 'Sistema de gestión de calidad certificado internacionalmente para todos los procesos administrativos y académicos.' },
  { icon: 'fas fa-star', title: 'Ranking QS', desc: 'Reconocida entre las mejores universidades de la región por calidad educativa, investigación e internacionalización.' },
  { icon: 'fas fa-handshake', title: 'Convenios Internacionales', desc: 'Más de 50 acuerdos con universidades en 30 países para intercambio académico y colaboración científica.' },
  { icon: 'fas fa-leaf', title: 'Certificación Ambiental', desc: 'Reconocimiento como campus sostenible por prácticas de eficiencia energética, gestión de residuos y responsabilidad ecológica.' },
  { icon: 'fas fa-users', title: 'Sello de Inclusión', desc: 'Certificación por políticas de equidad, diversidad e inclusión que garantizan una comunidad universitaria accesible para todos.' },
];

const stats = [
  { target: 15000, suffix: '+', label: 'Visitas de Usuarios' },
  { target: 800, suffix: '+', label: 'Fondo Documental' },
  { target: 45000, suffix: '+', label: 'Citas' },
  { target: 50, suffix: '+', label: 'Convenios Internacionales' },
];
const timeline = (await getCollection('timeline')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const mvv = (await getCollection('mvv')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const organigrama = (await getCollection('organigrama')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const campus = (await getCollection('campus')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const acreditaciones = (await getCollection('acreditaciones')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const stats = (await getCollection('stats-universidad')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout title="La Universidad – CRAI" description="Conoce la historia, misión, visión, valores y autoridades del CRAI.">
  <!-- HERO MODERNO S/FOTO -->
  <section class="hero hero--compact" aria-label="La Universidad">
    <div class="hero-bg hero-bg--plain"></div>
    <div class="hero-overlay"></div>
    <div class="hero-symbols" aria-hidden="true">
      <img src="/images/upr/icon-book.svg" class="hero-symbol hs-book" alt="" />
      <img src="/images/upr/icon-graduation.svg" class="hero-symbol hs-graduation" alt="" />
      <img src="/images/upr/icon-search.svg" class="hero-symbol hs-search" alt="" />
      <img src="/images/upr/icon-lightbulb.svg" class="hero-symbol hs-lightbulb" alt="" />
      <img src="/images/upr/icon-atom.svg" class="hero-symbol hs-atom" alt="" />
      <img src="/images/upr/icon-potion.svg" class="hero-symbol hs-potion" alt="" />
      <img src="/images/upr/icon-pencil.svg" class="hero-symbol hs-pencil" alt="" />
      <img src="/images/upr/icon-brain.svg" class="hero-symbol hs-brain" alt="" />
      <img src="/images/upr/icon-globe.svg" class="hero-symbol hs-globe" alt="" />
      <img src="/images/upr/icon-calculator.svg" class="hero-symbol hs-calculator" alt="" />
      <img src="/images/upr/icon-microscope.svg" class="hero-symbol hs-microscope" alt="" />
      <img src="/images/upr/icon-dna.svg" class="hero-symbol hs-dna" alt="" />
    </div>
    <div class="hero-particles" aria-hidden="true">
      <div class="hero-particle" style="--x:15%;--y:20%;--s:60px;--d:0s;"></div>
      <div class="hero-particle" style="--x:80%;--y:30%;--s:40px;--d:2s;"></div>
      <div class="hero-particle" style="--x:25%;--y:70%;--s:50px;--d:4s;"></div>
      <div class="hero-particle" style="--x:70%;--y:65%;--s:35px;--d:1s;"></div>
      <div class="hero-particle" style="--x:50%;--y:15%;--s:45px;--d:3s;"></div>
      <div class="hero-particle" style="--x:10%;--y:50%;--s:30px;--d:5s;"></div>
      <div class="hero-particle" style="--x:90%;--y:55%;--s:55px;--d:2.5s;"></div>
      <div class="hero-particle" style="--x:45%;--y:85%;--s:25px;--d:4.5s;"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge-wrapper">
        <span class="hero-badge">
          <img src="/images/305464304_448374310649340_2984277522454001566_n-Photoroom.png" alt="Logo UPR" class="univ-hero-logo" />
          Centro de Recursos
        </span>
      </div>
      <h1 class="hero-title univ-hero-title">Universidad de Pinar del Río <br><span class="univ-hero-accent">CRAI</span></h1>
      <p class="hero-subtitle">Conoce nuestra historia, misión, visión, valores y autoridades de nuestro centro.</p>
    </div>
  </section>

  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ul>
        <li><a href="/">Inicio</a></li>
        <li class="current" aria-current="page">Sobre Nosotros</li>
      </ul>
    </div>
  </nav>

  <!-- HISTORIA / TIMELINE -->
  <section id="historia" class="section" aria-labelledby="historia-title">
    <div class="container">
      <h2 class="section-title" id="historia-title">Nuestra Historia</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Más de seis décadas de excelencia académica e innovación educativa</p>
      <div class="timeline">
        {timeline.map((item) => (
          <div class="timeline-item reveal">
            <div class="timeline-content">
              <span class="timeline-year">{item.data.year}</span>
              <h3>{item.data.title}</h3>
              <p>{item.data.desc}</p>
            </div>
            <div class="timeline-dot"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MISIÓN, VISIÓN, VALORES -->
  <section id="mvv" class="section" style="background: var(--bg-light);" aria-labelledby="mvv-title">
    <div class="container">
      <h2 class="section-title" id="mvv-title">Misión, Visión y Valores</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Los principios que guían nuestra labor educativa e institucional</p>
      <div class="mvv-grid">
        {mvv.map((item) => (
          <div class="mvv-card reveal">
            <div class="mvv-icon"><i class={item.data.icon} aria-hidden="true"></i></div>
            <h3>{item.data.title}</h3>
            <p>{item.data.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AUTORIDADES -->
  <section id="autoridades" class="section" aria-labelledby="autoridades-title">
    <div class="container">
      <h2 class="section-title" id="autoridades-title">Autoridades Universitarias</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Conoce al equipo directivo que lidera nuestra institución</p>
      <div class="authorities-grid">
        {equipo.map((e) => (
          <div class="authority-card reveal">
            <div class="authority-img"><i class={e.data.icon ?? 'fas fa-user-tie'} aria-hidden="true"></i></div>
            <h4>{e.data.name}</h4>
            <span class="position">{e.data.position}</span>
            {e.data.bio && <p style="padding: 0 20px 20px; font-size: 0.88rem; color: var(--text-secondary);">{e.data.bio}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ORGANIGRAMA -->
  <section id="organigrama" class="section" style="background: var(--bg-warm);" aria-labelledby="org-title">
    <div class="container">
      <h2 class="section-title" id="org-title">Organigrama Institucional</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Estructura organizativa del CRAI </p>
      <div class="org-chart">
        {organigrama.map((level) => (
          <div class="org-level">
            {level.nodes.map((node) => {
              if (typeof node === 'object') {
                return (
                  <div class="org-branch">
                    <div class:list={['org-node', 'org-node-branch', level.level === 1 && 'level-1']}>{node.label}</div>
                    <div class="org-children">
                      {node.children.map((child) => (
                        <div class="org-node org-child">{child}</div>
                      ))}
                    </div>
                  </div>
                );
              }
              return <div class:list={['org-node', level.level === 1 && 'level-1']}>{node}</div>;
            })}
            {level.data.nodes.map((node) => (
              <div class:list={['org-node', level.data.level === 1 && 'level-1']}>{node}</div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CAMPUS Y SEDES -->
