<script>
  const mapFrame = document.getElementById('campus-map');
  const cards = Array.from(document.querySelectorAll('[data-campus-geo]'));

  const PLACE = '%2C%20Pinar%20del%20R%C3%ADo%2C%20Cuba';

  function showPlace(card) {
    const geo = card.getAttribute('data-campus-geo');
    if (!geo) return;
    mapFrame.setAttribute(
      'src',
      `https://www.google.com/maps?q=${geo}${PLACE}&z=16&hl=es&output=embed`
    );
    cards.forEach((c) => c.classList.toggle('campus-active', c === card));
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => showPlace(card));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        showPlace(card);
      }
    });
  });
</script>
