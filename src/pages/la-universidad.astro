---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIcons from '../components/SectionIcons.astro';
import { getCollection } from 'astro:content';

const equipo = (await getCollection('equipo')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const timeline = (await getCollection('timeline')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const mvv = (await getCollection('mvv')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const organigrama = (await getCollection('organigrama')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const campus = (await getCollection('campus')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const stats = (await getCollection('stats-universidad')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout title="La Universidad – CRAI" description="Conoce la historia, misión, visión, valores y autoridades del CRAI.">
  <!-- HERO MODERNO CON FOTO -->
  <section class="hero hero--compact" aria-label="La Universidad">
    <div
      class="hero-bg"
      style="background-image: url('/images/hero-universidad.jpg'); background-color: #0F2B1C;"
    ></div>
    <div class="hero-overlay"></div>
    <div class="hero-symbols" aria-hidden="true">
      <i class="fas fa-landmark hero-glyph hs-1"></i>
      <i class="fas fa-compass hero-glyph hs-2"></i>
      <i class="fas fa-house hero-glyph hs-3"></i>
      <i class="fas fa-bullseye hero-glyph hs-4"></i>
      <i class="fas fa-building-columns hero-glyph hs-5"></i>
      <i class="fas fa-sitemap hero-glyph hs-6"></i>
      <i class="fas fa-users hero-glyph hs-7"></i>
      <i class="fas fa-user-tie hero-glyph hs-8"></i>
      <i class="fas fa-location-dot hero-glyph hs-9"></i>
    </div>
    <div class="hero-particles" aria-hidden="true">
      <div class="hero-particle" style="--x:15%;--y:20%;--s:60px;--d:0s;"></div>
      <div class="hero-particle" style="--x:80%;--y:30%;--s:40px;--d:2s;"></div>
      <div class="hero-particle" style="--x:25%;--y:70%;--s:50px;--d:4s;"></div>
      <div class="hero-particle" style="--x:70%;--y:65%;--s:35px;--d:1s;"></div>
      <div class="hero-particle" style="--x:50%;--y:15%;--s:45px;--d:3s;"></div>
      <div class="hero-particle" style="--x:10%;--y:50%;--s:30px;--d:5s;"></div>
      <div class="hero-particle" style="--x:90%;--y:55%;--s:55px;--d:2.5s;"></div>
      <div class="hero-particle" style="--x:45%;--y:85%;--s:25px;--d:4.5s;"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge-wrapper">
        <span class="hero-badge">
          <img src="/images/305464304_448374310649340_2984277522454001566_n-Photoroom.png" alt="Logo UPR" class="univ-hero-logo" />
          Centro de Recursos
        </span>
      </div>
      <h1 class="hero-title univ-hero-title"><span class="univ-hero-accent">CRAI</span> en la Universidad de Pinar del Río</h1>
      <p class="hero-subtitle">Conoce nuestra historia, misión, visión, valores y autoridades de nuestro centro.</p>
    </div>
  </section>

  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ul>
        <li><a href="/">Inicio</a></li>
        <li class="current" aria-current="page">Sobre Nosotros</li>
      </ul>
    </div>
  </nav>

  <!-- HISTORIA / TIMELINE -->
  <section id="historia" class="section" aria-labelledby="historia-title">
    <SectionIcons icons={['fa-house', 'fa-compass', 'fa-landmark']} />
    <div class="container">
      <span class="section-eyebrow">Historia</span>
      <h2 class="section-title" id="historia-title">Nuestra Historia</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Más de seis décadas de excelencia académica e innovación educativa</p>
      <div class="timeline">
        {timeline.map((item) => (
          <div class="timeline-item reveal">
            <div class="timeline-content">
              <span class="timeline-year">{item.data.year}</span>
              <h3>{item.data.title}</h3>
              <p>{item.data.desc}</p>
            </div>
            <div class="timeline-dot"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MISIÓN, VISIÓN, VALORES -->
  <section id="mvv" class="section" style="background: var(--bg-light);" aria-labelledby="mvv-title">
    <SectionIcons icons={['fa-bullseye', 'fa-eye', 'fa-heart']} align="left" />
    <div class="container">
      <span class="section-eyebrow">Identidad</span>
      <h2 class="section-title" id="mvv-title">Misión, Visión y Valores</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Los principios que guían nuestra labor educativa e institucional</p>
      <div class="mvv-grid">
        {mvv.map((item) => (
          <div class="mvv-card reveal">
            <div class="mvv-icon"><i class={item.data.icon} aria-hidden="true"></i></div>
            <h3>{item.data.title}</h3>
            <p>{item.data.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SEDES -->
  <section id="sedes" class="section" aria-labelledby="sedes-title">
    <SectionIcons icons={['fa-building', 'fa-location-dot', 'fa-map-pin']} />
    <div class="container">
      <span class="section-eyebrow">Bibliotecas</span>
      <h2 class="section-title" id="sedes-title">Nuestras Bibliotecas</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Nuestras instalaciones están distribuidas estratégicamente para brindar cobertura nacional</p>
      <div class="sedes-map-wrap">
        <div id="campus-map" class="campus-map"></div>
      </div>
      <div class="sedes-grid">
        {campus.map((c, i) => (
          <div
            class={`sedes-card reveal${i === 0 ? ' campus-active' : ''}`}
            role="button"
            tabindex="0"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-campus-geo={c.data.geo}
            data-campus-name={c.data.name}>
            <span class="sedes-card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="sedes-card-icon"><i class={c.data.icon} aria-hidden="true"></i></span>
            <h3 class="sedes-card-title">{c.data.name}</h3>
            <p class="sedes-card-desc">{c.data.desc}</p>
            <span class="sedes-card-hint">
              <i class="fas fa-map-location-dot" aria-hidden="true"></i>
              Ver en el mapa
              <i class="fas fa-arrow-right hint-arrow" aria-hidden="true"></i>
            </span>
          </div>
        ))}
      </div>
    </div>
    <script is:inline src="/js/campus-map.js" defer></script>
  </section>

  
  <!-- ORGANIGRAMA -->
  <section id="organigrama" class="section" style="background: var(--bg-warm);" aria-labelledby="org-title">
    <SectionIcons icons={['fa-sitemap', 'fa-users', 'fa-building-columns']} align="left" />
    <div class="container">
      <span class="section-eyebrow">Estructura</span>
      <h2 class="section-title" id="org-title">Organigrama Institucional</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Estructura organizativa del CRAI</p>
      <div class="org-chart">
        {organigrama.map((level) => (
          <div class="org-level">
            {level.data.nodes.map((node) => (
              <div class:list={['org-node', level.data.level === 1 && 'level-1']}>{node}</div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section> 

  <!-- AUTORIDADES -->
  <section id="autoridades" class="section" aria-labelledby="autoridades-title">
    <SectionIcons icons={['fa-user-tie', 'fa-id-card', 'fa-crown']} />
    <div class="container">
      <span class="section-eyebrow">Equipo</span>
      <h2 class="section-title" id="autoridades-title">Autoridades Universitarias</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Conoce al equipo directivo que lidera nuestra institución</p>
      <div class="authorities-grid">
        {equipo.map((e) => (
          <div class="authority-card reveal">
            <div class="authority-img"><i class={e.data.icon ?? 'fas fa-user-tie'} aria-hidden="true"></i></div>
            <h4>{e.data.name}</h4>
            <span class="position">{e.data.position}</span>
            {e.data.bio && <p style="padding: 0 20px 20px; font-size: 0.88rem; color: var(--text-secondary);">{e.data.bio}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- DATOS RÁPIDOS -->
  <section class="stats-section" aria-labelledby="stats-title">
    <SectionIcons icons={['fa-chart-line', 'fa-chart-bar', 'fa-chart-pie']} />
    <div class="container">
      <span class="section-eyebrow section-eyebrow--light">Impacto</span>
      <h2 class="section-title section-title--light" id="stats-title">CRAI en cifras</h2>
      <div class="section-divider" style="background: var(--secondary);" aria-hidden="true"></div>
      <p class="section-subtitle" style="color: rgba(255,255,255,0.8);">Más de cinco décadas formando profesionales que transforman el mundo</p>
      <div class="stats-grid">
        {stats.map((s) => (
          <div class="stat-item reveal">
            <span class="stat-number" data-target={s.data.target}>0</span><span class="stat-plus">{s.data.suffix}</span>
            <span class="stat-label">{s.data.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    /* Sin filtro de color: overlay neutro (negro) para que la foto mantenga sus
       colores originales y el texto siga siendo legible en las zonas claras */
    .hero .hero-overlay {
      background:
        radial-gradient(
          ellipse 70% 62% at 50% 54%,
          rgba(0, 0, 0, 0.5) 0%,
          rgba(0, 0, 0, 0.24) 55%,
          transparent 75%
        ),
        linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.08) 50%, rgba(0, 0, 0, 0.34) 100%);
    }

    /* "CRAI" alineado con el resto del título en una sola línea */
    .hero .univ-hero-title .univ-hero-accent {
      display: inline;
    }
  </style>
</BaseLayout>

