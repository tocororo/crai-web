---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { getCollection } from 'astro:content';

const equipo = (await getCollection('equipo')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const timeline = [
  { year: '1965', title: 'Fundación', desc: 'La Universidad del Futuro abre sus puertas con una visión pionera en educación superior, ofreciendo programas innovadores en ciencias y humanidades.' },
  { year: '1975', title: 'Primer Campus', desc: 'Se inaugura el Campus Central con instalaciones de vanguardia, consolidando la presencia institucional y duplicando la capacidad estudiantil.' },
  { year: '1985', title: 'Programas de Posgrado', desc: 'Se crea la Escuela de Posgrado con maestrías y doctorados en diversas áreas, posicionando a la universidad como referente académico nacional.' },
  { year: '1995', title: 'Internacionalización', desc: 'Se establecen convenios con universidades de Europa, América y Asia, permitiendo intercambios estudiantiles y colaboraciones internacionales.' },
  { year: '2005', title: 'Acreditación', desc: 'La universidad obtiene la acreditación institucional de alto nivel, reconociendo la calidad académica y la gestión institucional.' },
  { year: '2015', title: 'Innovación Digital', desc: 'Se implementa un ambicioso plan de transformación digital con aulas inteligentes, plataformas virtuales y programas de educación en línea.' },
  { year: '2025', title: 'Futuro Sostenible', desc: 'Lanzamiento de la iniciativa de campus sostenible y programas académicos centrados en los ODS, reafirmando el compromiso con el desarrollo sustentable.' },
];

const mvv = [
  { icon: 'fas fa-bullseye', title: 'Misión', desc: 'Formar profesionales íntegros, competentes y comprometidos con el desarrollo sostenible de la sociedad, mediante una educación de excelencia que integra la docencia, la investigación y la extensión universitaria.' },
  { icon: 'fas fa-eye', title: 'Visión', desc: 'Ser una universidad de referencia internacional reconocida por su calidad académica, su contribución al avance del conocimiento y su impacto positivo en la transformación social hacia un futuro más equitativo y sostenible.' },
  { icon: 'fas fa-heart', title: 'Valores', desc: 'Excelencia, ética, inclusión, innovación, responsabilidad social, respeto a la diversidad, compromiso con la verdad y el pensamiento crítico como pilares de nuestra comunidad universitaria.' },
];

const organigrama = [
  { level: 1, nodes: ['Consejo Universitario'] },
  { level: 2, nodes: ['Rectoría'] },
  { level: 3, nodes: ['Vicerrectoría Académica', 'Vicerrectoría de Investigación', 'Vicerrectoría Administrativa'] },
  { level: 4, nodes: ['Facultades', 'Institutos de Investigación', 'Dirección de Extensión', 'Secretaría General'] },
  { level: 5, nodes: ['Departamentos Académicos', 'Laboratorios', 'Centros de Estudio', 'Biblioteca Central'] },
];

const campus = [
  { icon: 'fas fa-university', name: 'Campus Central', desc: 'Av. Universitaria 123, Ciudad Capital. Edificio principal con aulas modernas, auditorio, laboratorios y biblioteca central.' },
  { icon: 'fas fa-leaf', name: 'Campus Norte', desc: 'Carretera Norte km 8, Ciudad Industrial. Enfocado en programas de ingeniería y ciencias aplicadas.' },
  { icon: 'fas fa-tree', name: 'Campus Sur', desc: 'Av. del Bosque 456, Zona Sur. Especializado en ciencias biológicas, ambientales y agropecuarias.' },
  { icon: 'fas fa-globe-americas', name: 'Sede Internacional', desc: 'Calle del Saber 789, Distrito Internacional. Centro de posgrado y programas de cooperación global.' },
];

const acreditaciones = [
  { icon: 'fas fa-certificate', title: 'Acreditación Institucional', desc: 'Certificación de alta calidad otorgada por el Consejo Nacional de Acreditación, vigente hasta 2028.' },
  { icon: 'fas fa-trophy', title: 'Certificación ISO 9001', desc: 'Sistema de gestión de calidad certificado internacionalmente para todos los procesos administrativos y académicos.' },
  { icon: 'fas fa-star', title: 'Ranking QS', desc: 'Reconocida entre las mejores universidades de la región por calidad educativa, investigación e internacionalización.' },
  { icon: 'fas fa-handshake', title: 'Convenios Internacionales', desc: 'Más de 50 acuerdos con universidades en 30 países para intercambio académico y colaboración científica.' },
  { icon: 'fas fa-leaf', title: 'Certificación Ambiental', desc: 'Reconocimiento como campus sostenible por prácticas de eficiencia energética, gestión de residuos y responsabilidad ecológica.' },
  { icon: 'fas fa-users', title: 'Sello de Inclusión', desc: 'Certificación por políticas de equidad, diversidad e inclusión que garantizan una comunidad universitaria accesible para todos.' },
];

const stats = [
  { value: '15,000+', label: 'Estudiantes' },
  { value: '800+', label: 'Docentes' },
  { value: '45,000+', label: 'Egresados' },
  { value: '50+', label: 'Convenios Internacionales' },
];
---

<BaseLayout title="La Universidad – CRAI" description="Conoce la historia, misión, visión, valores y autoridades del CRAI.">
  <PageHero
    badgeIcon="fa-university"
    badge="Centro de Recursos"
    breadcrumb="Sobre Nosotros"
    title="CRAI"
    subtitle="Conoce nuestra historia, misión y valores"
  />

  <!-- Historia / Timeline -->
  <Section id="historia" title="Nuestra Historia" subtitle="Más de seis décadas de excelencia académica e innovación educativa">
    <div class="relative ml-4 border-l-2 border-primary-500/30">
      {timeline.map((item, i) => (
        <div class={`reveal relative mb-10 ml-8 ${i % 2 === 0 ? '' : ''}`}>
          <span class="absolute -left-12 top-1 flex h-6 w-6 items-center justify-center rounded-full bg-primary-500 text-xs font-bold text-white ring-4 ring-white dark:ring-slate-900">
            {i + 1}
          </span>
          <div class="rounded-xl border border-border bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
            <span class="mb-2 inline-block rounded-full bg-secondary-400/10 px-3 py-1 text-xs font-bold text-secondary-400">{item.year}</span>
            <h3 class="font-heading text-lg font-bold text-text dark:text-white">{item.title}</h3>
            <p class="mt-2 text-sm text-text-secondary dark:text-gray-300">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- Misión, Visión y Valores -->
  <Section id="mvv" title="Misión, Visión y Valores" subtitle="Los principios que guían nuestra labor educativa e institucional" light>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {mvv.map((item) => (
        <div class="card-hover reveal flex flex-col items-center rounded-xl border border-border bg-white p-8 text-center shadow-sm dark:border-slate-700 dark:bg-slate-800">
          <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary-500/10 text-3xl text-primary-500">
            <i class={item.icon}></i>
          </div>
          <h3 class="font-heading text-xl font-bold text-text dark:text-white">{item.title}</h3>
          <p class="mt-4 text-sm leading-relaxed text-text-secondary dark:text-gray-300">{item.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Autoridades -->
  <Section id="autoridades" title="Autoridades Universitarias" subtitle="Conoce al equipo directivo que lidera nuestra institución">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {equipo.map((e) => (
        <div class="card-hover reveal rounded-xl border border-border bg-white p-6 text-center shadow-sm dark:border-slate-700 dark:bg-slate-800">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary-500/10 text-3xl text-primary-500">
            <i class={e.data.icon ?? 'fas fa-user'}></i>
          </div>
          <h4 class="font-heading text-lg font-bold text-text dark:text-white">{e.data.name}</h4>
          <span class="mt-1 inline-block rounded-full bg-secondary-400/10 px-3 py-1 text-xs font-semibold text-secondary-400">{e.data.position}</span>
          {e.data.bio && <p class="mt-4 text-sm text-text-secondary dark:text-gray-300">{e.data.bio}</p>}
        </div>
      ))}
    </div>
  </Section>

  <!-- Organigrama -->
  <Section id="organigrama" title="Organigrama Institucional" subtitle="Estructura organizativa de nuestra casa de estudios" light>
    <div class="flex flex-col items-center gap-0">
      {organigrama.map((level, li) => (
        <div class={`reveal flex flex-wrap justify-center gap-4 pb-6 ${li < organigrama.length - 1 ? 'border-b border-primary-500/20 w-full' : ''}`} style={li < organigrama.length - 1 ? { paddingBottom: '1.5rem' } : {}}>
          {level.nodes.map((node) => (
            <div class={`rounded-lg border px-5 py-3 text-center text-sm font-semibold shadow-sm transition-shadow hover:shadow-md
              ${level.level === 1
                ? 'border-primary-500 bg-primary-500 text-white font-heading text-base'
                : level.level === 2
                  ? 'border-secondary-400 bg-secondary-400/10 text-text font-heading dark:text-white'
                  : 'border-border bg-white text-text-secondary dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300'
              }`}>
              {node}
            </div>
          ))}
        </div>
      ))}
    </div>
  </Section>

  <!-- Campus y Sedes -->
  <Section id="campus" title="Campus y Sedes" subtitle="Nuestras instalaciones están distribuidas estratégicamente para brindar cobertura nacional">
    <div class="mb-8 flex flex-col items-center justify-center rounded-xl border border-border bg-surface-2 p-10 text-center dark:border-slate-700 dark:bg-slate-800/40">
      <i class="fas fa-map-marked-alt mb-4 text-5xl text-primary-500/50"></i>
      <p class="font-heading text-lg font-semibold text-text dark:text-white">Mapa interactivo de campus y sedes</p>
      <span class="mt-2 text-sm text-text-secondary dark:text-gray-400">Campus Central · Campus Norte · Campus Sur · Sede Internacional</span>
    </div>
    <div class="grid gap-6 sm:grid-cols-2">
      {campus.map((c) => (
        <div class="card-hover reveal rounded-xl border border-border bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
          <h3 class="font-heading text-lg font-bold text-text dark:text-white">
            <i class={`mr-2 text-secondary-400 ${c.icon}`}></i>{c.name}
          </h3>
          <p class="mt-3 text-sm text-text-secondary dark:text-gray-300">{c.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Acreditaciones -->
  <Section id="acreditaciones" title="Acreditaciones y Reconocimientos" subtitle="Certificaciones que avalan nuestra calidad académica e institucional" light>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {acreditaciones.map((a) => (
        <div class="card-hover reveal flex flex-col items-center rounded-xl border border-border bg-white p-8 text-center shadow-sm dark:border-slate-700 dark:bg-slate-800">
          <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary-500/10 text-2xl text-primary-500">
            <i class={a.icon}></i>
          </div>
          <h3 class="font-heading text-base font-bold text-text dark:text-white">{a.title}</h3>
          <p class="mt-3 text-sm text-text-secondary dark:text-gray-300">{a.desc}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Datos Rápidos -->
  <section class="bg-gradient-to-br from-primary-700 via-primary-600 to-primary-800 py-16 text-white">
    <div class="container-crai text-center">
      <h2 class="font-heading text-3xl font-extrabold text-white sm:text-4xl">La Universidad en Cifras</h2>
      <div class="mx-auto my-4 h-1 w-20 rounded bg-secondary-400" aria-hidden="true"></div>
      <p class="mb-10 text-white/80">Más de cinco décadas formando profesionales que transforman el mundo</p>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="reveal">
            <span class="font-heading text-4xl font-extrabold text-secondary-300 sm:text-5xl">{s.value}</span>
            <p class="mt-2 text-sm text-white/80">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
