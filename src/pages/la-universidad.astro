---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';

const equipo = (await getCollection('equipo')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const timeline = (await getCollection('timeline')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const mvv = (await getCollection('mvv')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const organigrama = (await getCollection('organigrama')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const campus = (await getCollection('campus')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const acreditaciones = (await getCollection('acreditaciones')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const stats = (await getCollection('stats-universidad')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout title="La Universidad – CRAI" description="Conoce la historia, misión, visión, valores y autoridades del CRAI.">
  <PageHero
    badgeIcon="fa-university"
    badge="Centro de Recursos"
    title="CRAI"
    subtitle="Conoce nuestra historia, misión y valores"
    crumb="Sobre Nosotros"
  />

  <!-- HISTORIA / TIMELINE -->
  <section id="historia" class="section" aria-labelledby="historia-title">
    <div class="container">
      <h2 class="section-title" id="historia-title">Nuestra Historia</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Más de seis décadas de excelencia académica e innovación educativa</p>
      <div class="timeline">
        {timeline.map((item) => (
          <div class="timeline-item reveal">
            <div class="timeline-content">
              <span class="timeline-year">{item.data.year}</span>
              <h3>{item.data.title}</h3>
              <p>{item.data.desc}</p>
            </div>
            <div class="timeline-dot"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MISIÓN, VISIÓN, VALORES -->
  <section id="mvv" class="section" style="background: var(--bg-light);" aria-labelledby="mvv-title">
    <div class="container">
      <h2 class="section-title" id="mvv-title">Misión, Visión y Valores</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Los principios que guían nuestra labor educativa e institucional</p>
      <div class="mvv-grid">
        {mvv.map((item) => (
          <div class="mvv-card reveal">
            <div class="mvv-icon"><i class={item.data.icon} aria-hidden="true"></i></div>
            <h3>{item.data.title}</h3>
            <p>{item.data.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AUTORIDADES -->
  <section id="autoridades" class="section" aria-labelledby="autoridades-title">
    <div class="container">
      <h2 class="section-title" id="autoridades-title">Autoridades Universitarias</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Conoce al equipo directivo que lidera nuestra institución</p>
      <div class="authorities-grid">
        {equipo.map((e) => (
          <div class="authority-card reveal">
            <div class="authority-img"><i class={e.data.icon ?? 'fas fa-user-tie'} aria-hidden="true"></i></div>
            <h4>{e.data.name}</h4>
            <span class="position">{e.data.position}</span>
            {e.data.bio && <p style="padding: 0 20px 20px; font-size: 0.88rem; color: var(--text-secondary);">{e.data.bio}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ORGANIGRAMA -->
  <section id="organigrama" class="section" style="background: var(--bg-warm);" aria-labelledby="org-title">
    <div class="container">
      <h2 class="section-title" id="org-title">Organigrama Institucional</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Estructura organizativa del CRAI </p>
      <div class="org-chart">
        {organigrama.map((level) => (
          <div class="org-level">
            {level.data.nodes.map((node) => (
              <div class:list={['org-node', level.data.level === 1 && 'level-1']}>{node}</div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CAMPUS Y SEDES -->
  <section id="campus" class="section" aria-labelledby="campus-title">
    <div class="container">
      <h2 class="section-title" id="campus-title">Campus y Sedes</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Nuestras instalaciones están distribuidas estratégicamente para brindar cobertura nacional</p>
      <div class="map-placeholder" aria-label="Mapa de campus y sedes">
        <i class="fas fa-map-marked-alt" aria-hidden="true"></i>
        <p>Mapa interactivo de campus y sedes</p>
        <span style="font-size: 0.85rem;">Campus Central · Campus Norte · Campus Sur · Sede Internacional</span>
      </div>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 32px;">
        {campus.map((c) => (
          <div class="mvv-card reveal" style="text-align: left;">
            <h3 style="color: var(--primary); font-family: var(--font-title);"><i class={c.data.icon} aria-hidden="true" style="color: var(--secondary);"></i> {c.data.name}</h3>
            <p style="font-size: 0.9rem; color: var(--text-secondary);">{c.data.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ACREDITACIONES -->
  <section id="acreditaciones" class="section" style="background: var(--bg-light);" aria-labelledby="acreditaciones-title">
    <div class="container">
      <h2 class="section-title" id="acreditaciones-title">Acreditaciones y Reconocimientos</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Certificaciones que avalan nuestra calidad institucional</p>
      <div class="content-grid">
        {acreditaciones.map((a) => (
          <div class="content-card reveal">
            <div class="content-card-icon"><i class={a.data.icon} aria-hidden="true"></i></div>
            <h3>{a.data.title}</h3>
            <p>{a.data.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DATOS RÁPIDOS -->
  <section class="stats-section" aria-labelledby="stats-title">
    <div class="container">
      <h2 class="section-title" style="color: var(--text-light);" id="stats-title">La Universidad en Cifras</h2>
      <div class="section-divider" style="background: var(--secondary);" aria-hidden="true"></div>
      <p class="section-subtitle" style="color: rgba(255,255,255,0.8);">Más de cinco décadas formando profesionales que transforman el mundo</p>
      <div class="stats-grid">
        {stats.map((s) => (
          <div class="stat-item reveal">
            <span class="stat-number" data-target={s.data.target}>0</span><span class="stat-plus">{s.data.suffix}</span>
            <span class="stat-label">{s.data.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
