---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';

const equipo = (await getCollection('equipo')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const timeline = [
  { year: '1972', title: 'Creación', desc: 'Creación de la Biblioteca Universitaria y de la Direccion de Información científico Técnico. Implementacion de los servicios básicos de información a la comunidad universitaria.'},
  { year: '1985', title: 'Creación de la Red de Bibliotecas', desc: 'Creación de la Red de Bibliotecas del Ministerio de Educación Superior.' },
  { year: '1986', title: 'Biblioteca y Tecnología', desc: 'Inicio la dotación de infraestructura tecnológica avanzada y la creación de nuevos servicios de información.' },
  { year: '1995', title: 'Inicio de la carrera de Bibliotecología y Ciencias de la Información', desc: 'Inicio de los estudios de la carrera de Bibliotecología y Ciencias de la Información a través del proceso de universalización.' },
  { year: '2002', title: 'Adquisición de Bases de Datos Bibliográficos', desc: 'Adquisición de las primeras bases de datos bibliográficos de Información.' },
  { year: '2005', title: 'Biblioteca en función de la docencia', desc: 'Creación del grupo PROGINTEC, a traves del proyecto para el desarrollo de tecnologías de la información. La biblioteca asume la función docente.' },
  { year: '2011', title: 'Creación de Servicios de la Sala Abierta', desc: 'Creación del servicio de sala abierta en el pasillo de la biblioteca Hermanos Saíz.' },
  { year: '2012', title: 'Primer Taller Internacional de Bibliotecas', desc: 'Celebración del primer taller internacional de Bibliotecas Digitales' },
  { year: '2015', title: 'Creación del CRAI', desc: 'Creación del Centro de Recursos para el Aprendizaje y la Investigación con la integración de las Bibliotecas Universitarias de la sede Nancy Urunga, Rafael M. Mendive y Hermanos Saíz. Creación del departamento Docente Ciencias de la Información.' },
  { year: '2017', title: 'Creación del Departamento de Sistema', desc: 'Creación del departamento de Sistema y Tecnologias de la Información. El departamento de publicaciones sale del CRAI para convertirse en Dirección Editorial.' },
];

const mvv = [
  { icon: 'fas fa-bullseye', title: 'Misión', desc: 'Formar profesionales íntegros, competentes y comprometidos con el desarrollo sostenible de la sociedad, mediante una educación de excelencia que integra la docencia, la investigación y la extensión universitaria.' },
  { icon: 'fas fa-eye', title: 'Visión', desc: 'Ser una universidad de referencia internacional reconocida por su calidad académica, su contribución al avance del conocimiento y su impacto positivo en la transformación social hacia un futuro más equitativo y sostenible.' },
  { icon: 'fas fa-heart', title: 'Valores', desc: 'Excelencia, ética, inclusión, innovación, responsabilidad social, respeto a la diversidad, compromiso con la verdad y el pensamiento crítico como pilares de nuestra comunidad universitaria.' },
];

const organigrama = [
  { level: 1, nodes: ['Vicerrectoría'] },
  { level: 2, nodes: ['Dirección CRAI'] },
  { level: 3, nodes: ['Departamento Docente Ciencias de la Información', 'Departamento de Sistema tecnologías de la Información', 'Subdirección Bibliotecas'] },
  { level: 4, nodes: ['Biblioteca Hermanos Saíz', 'Biblioteca Nancy Uranga', 'Rafael M. Mendive',] },
  ]

const campus = [
  { icon: 'fas fa-university', name: 'Campus Central', desc: 'Av. Universitaria 123, Ciudad Capital. Edificio principal con aulas modernas, auditorio, laboratorios y biblioteca central.' },
  { icon: 'fas fa-leaf', name: 'Campus Norte', desc: 'Carretera Norte km 8, Ciudad Industrial. Enfocado en programas de ingeniería y ciencias aplicadas.' },
  { icon: 'fas fa-tree', name: 'Campus Sur', desc: 'Av. del Bosque 456, Zona Sur. Especializado en ciencias biológicas, ambientales y agropecuarias.' },
  { icon: 'fas fa-globe-americas', name: 'Sede Internacional', desc: 'Calle del Saber 789, Distrito Internacional. Centro de posgrado y programas de cooperación global.' },
];

const acreditaciones = [
  { icon: 'fas fa-certificate', title: 'Acreditación Institucional', desc: 'Certificación de alta calidad otorgada por el Consejo Nacional de Acreditación, vigente hasta 2028.' },
  { icon: 'fas fa-trophy', title: 'Certificación ISO 9001', desc: 'Sistema de gestión de calidad certificado internacionalmente para todos los procesos administrativos y académicos.' },
  { icon: 'fas fa-star', title: 'Ranking QS', desc: 'Reconocida entre las mejores universidades de la región por calidad educativa, investigación e internacionalización.' },
  { icon: 'fas fa-handshake', title: 'Convenios Internacionales', desc: 'Más de 50 acuerdos con universidades en 30 países para intercambio académico y colaboración científica.' },
  { icon: 'fas fa-leaf', title: 'Certificación Ambiental', desc: 'Reconocimiento como campus sostenible por prácticas de eficiencia energética, gestión de residuos y responsabilidad ecológica.' },
  { icon: 'fas fa-users', title: 'Sello de Inclusión', desc: 'Certificación por políticas de equidad, diversidad e inclusión que garantizan una comunidad universitaria accesible para todos.' },
];

const stats = [
  { target: 15000, suffix: '+', label: 'Visitas de Usuarios' },
  { target: 800, suffix: '+', label: 'Fondo Documental' },
  { target: 45000, suffix: '+', label: 'Citas' },
  { target: 50, suffix: '+', label: 'Convenios Internacionales' },
];
---

<BaseLayout title="La Universidad – CRAI" description="Conoce la historia, misión, visión, valores y autoridades del CRAI.">
  <PageHero
    badgeIcon="fa-university"
    badge="Centro de Recursos"
    title="CRAI"
    subtitle="Conoce nuestra historia, misión y valores"
    crumb="Sobre Nosotros"
  />

  <!-- HISTORIA / TIMELINE -->
  <section id="historia" class="section" aria-labelledby="historia-title">
    <div class="container">
      <h2 class="section-title" id="historia-title">Nuestra Historia</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Más de seis décadas de excelencia académica e innovación educativa</p>
      <div class="timeline">
        {timeline.map((item) => (
          <div class="timeline-item reveal">
            <div class="timeline-content">
              <span class="timeline-year">{item.year}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
            <div class="timeline-dot"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MISIÓN, VISIÓN, VALORES -->
  <section id="mvv" class="section" style="background: var(--bg-light);" aria-labelledby="mvv-title">
    <div class="container">
      <h2 class="section-title" id="mvv-title">Misión, Visión y Valores</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Los principios que guían nuestra labor educativa e institucional</p>
      <div class="mvv-grid">
        {mvv.map((item) => (
          <div class="mvv-card reveal">
            <div class="mvv-icon"><i class={item.icon} aria-hidden="true"></i></div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AUTORIDADES -->
  <section id="autoridades" class="section" aria-labelledby="autoridades-title">
    <div class="container">
      <h2 class="section-title" id="autoridades-title">Autoridades Universitarias</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Conoce al equipo directivo que lidera nuestra institución</p>
      <div class="authorities-grid">
        {equipo.map((e) => (
          <div class="authority-card reveal">
            <div class="authority-img"><i class={e.data.icon ?? 'fas fa-user-tie'} aria-hidden="true"></i></div>
            <h4>{e.data.name}</h4>
            <span class="position">{e.data.position}</span>
            {e.data.bio && <p style="padding: 0 20px 20px; font-size: 0.88rem; color: var(--text-secondary);">{e.data.bio}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ORGANIGRAMA -->
  <section id="organigrama" class="section" style="background: var(--bg-warm);" aria-labelledby="org-title">
    <div class="container">
      <h2 class="section-title" id="org-title">Organigrama Institucional</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Estructura organizativa del CRAI </p>
      <div class="org-chart">
        {organigrama.map((level) => (
          <div class="org-level">
            {level.nodes.map((node) => (
              <div class:list={['org-node', level.level === 1 && 'level-1']}>{node}</div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CAMPUS Y SEDES -->
  <section id="campus" class="section" aria-labelledby="campus-title">
    <div class="container">
      <h2 class="section-title" id="campus-title">Campus y Sedes</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Nuestras instalaciones están distribuidas estratégicamente para brindar cobertura nacional</p>
      <div class="map-placeholder" aria-label="Mapa de campus y sedes">
        <i class="fas fa-map-marked-alt" aria-hidden="true"></i>
        <p>Mapa interactivo de campus y sedes</p>
        <span style="font-size: 0.85rem;">Campus Central · Campus Norte · Campus Sur · Sede Internacional</span>
      </div>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 32px;">
        {campus.map((c) => (
          <div class="mvv-card reveal" style="text-align: left;">
            <h3 style="color: var(--primary); font-family: var(--font-title);"><i class={c.icon} aria-hidden="true" style="color: var(--secondary);"></i> {c.name}</h3>
            <p style="font-size: 0.9rem; color: var(--text-secondary);">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- DATOS RÁPIDOS -->
  <section class="stats-section" aria-labelledby="stats-title">
    <div class="container">
      <h2 class="section-title" style="color: var(--text-light);" id="stats-title">La Universidad en Cifras</h2>
      <div class="section-divider" style="background: var(--secondary);" aria-hidden="true"></div>
      <p class="section-subtitle" style="color: rgba(255,255,255,0.8);">Más de cinco décadas formando profesionales que transforman el mundo</p>
      <div class="stats-grid">
        {stats.map((s) => (
          <div class="stat-item reveal">
            <span class="stat-number" data-target={s.target}>0</span><span class="stat-plus">{s.suffix}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
