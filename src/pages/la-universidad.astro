---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const equipo = (await getCollection('equipo')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const timeline = (await getCollection('timeline')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const mvv = (await getCollection('mvv')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const organigrama = (await getCollection('organigrama')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const campus = (await getCollection('campus')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const acreditaciones = (await getCollection('acreditaciones')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const stats = (await getCollection('stats-universidad')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout title="La Universidad – CRAI" description="Conoce la historia, misión, visión, valores y autoridades del CRAI.">
  <!-- HERO MODERNO S/FOTO -->
  <section class="hero hero--compact" aria-label="La Universidad">
    <div class="hero-bg hero-bg--plain"></div>
    <div class="hero-overlay"></div>
    <div class="hero-symbols" aria-hidden="true">
      <img src="/images/upr/icon-book.svg" class="hero-symbol hs-book" alt="" />
      <img src="/images/upr/icon-graduation.svg" class="hero-symbol hs-graduation" alt="" />
      <img src="/images/upr/icon-search.svg" class="hero-symbol hs-search" alt="" />
      <img src="/images/upr/icon-lightbulb.svg" class="hero-symbol hs-lightbulb" alt="" />
      <img src="/images/upr/icon-atom.svg" class="hero-symbol hs-atom" alt="" />
      <img src="/images/upr/icon-potion.svg" class="hero-symbol hs-potion" alt="" />
      <img src="/images/upr/icon-pencil.svg" class="hero-symbol hs-pencil" alt="" />
      <img src="/images/upr/icon-brain.svg" class="hero-symbol hs-brain" alt="" />
      <img src="/images/upr/icon-globe.svg" class="hero-symbol hs-globe" alt="" />
      <img src="/images/upr/icon-calculator.svg" class="hero-symbol hs-calculator" alt="" />
      <img src="/images/upr/icon-microscope.svg" class="hero-symbol hs-microscope" alt="" />
      <img src="/images/upr/icon-dna.svg" class="hero-symbol hs-dna" alt="" />
    </div>
    <div class="hero-particles" aria-hidden="true">
      <div class="hero-particle" style="--x:15%;--y:20%;--s:60px;--d:0s;"></div>
      <div class="hero-particle" style="--x:80%;--y:30%;--s:40px;--d:2s;"></div>
      <div class="hero-particle" style="--x:25%;--y:70%;--s:50px;--d:4s;"></div>
      <div class="hero-particle" style="--x:70%;--y:65%;--s:35px;--d:1s;"></div>
      <div class="hero-particle" style="--x:50%;--y:15%;--s:45px;--d:3s;"></div>
      <div class="hero-particle" style="--x:10%;--y:50%;--s:30px;--d:5s;"></div>
      <div class="hero-particle" style="--x:90%;--y:55%;--s:55px;--d:2.5s;"></div>
      <div class="hero-particle" style="--x:45%;--y:85%;--s:25px;--d:4.5s;"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge-wrapper">
        <span class="hero-badge">
          <img src="/images/305464304_448374310649340_2984277522454001566_n-Photoroom.png" alt="Logo UPR" class="univ-hero-logo" />
          Centro de Recursos
        </span>
      </div>
      <h1 class="hero-title univ-hero-title">Universidad de Pinar del Río <br><span class="univ-hero-accent">CRAI</span></h1>
      <p class="hero-subtitle">Conoce nuestra historia, misión, visión, valores y autoridades de nuestro centro.</p>
    </div>
  </section>

  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ul>
        <li><a href="/">Inicio</a></li>
        <li class="current" aria-current="page">Sobre Nosotros</li>
      </ul>
    </div>
  </nav>

  <!-- HISTORIA / TIMELINE -->
  <section id="historia" class="section" aria-labelledby="historia-title">
    <div class="container">
      <h2 class="section-title" id="historia-title">Nuestra Historia</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Más de seis décadas de excelencia académica e innovación educativa</p>
      <div class="timeline">
        {timeline.map((item) => (
          <div class="timeline-item reveal">
            <div class="timeline-content">
              <span class="timeline-year">{item.data.year}</span>
              <h3>{item.data.title}</h3>
              <p>{item.data.desc}</p>
            </div>
            <div class="timeline-dot"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MISIÓN, VISIÓN, VALORES -->
  <section id="mvv" class="section" style="background: var(--bg-light);" aria-labelledby="mvv-title">
    <div class="container">
      <h2 class="section-title" id="mvv-title">Misión, Visión y Valores</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Los principios que guían nuestra labor educativa e institucional</p>
      <div class="mvv-grid">
        {mvv.map((item) => (
          <div class="mvv-card reveal">
            <div class="mvv-icon"><i class={item.data.icon} aria-hidden="true"></i></div>
            <h3>{item.data.title}</h3>
            <p>{item.data.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AUTORIDADES -->
  <section id="autoridades" class="section" aria-labelledby="autoridades-title">
    <div class="container">
      <h2 class="section-title" id="autoridades-title">Autoridades Universitarias</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Conoce al equipo directivo que lidera nuestra institución</p>
      <div class="authorities-grid">
        {equipo.map((e) => (
          <div class="authority-card reveal">
            <div class="authority-img"><i class={e.data.icon ?? 'fas fa-user-tie'} aria-hidden="true"></i></div>
            <h4>{e.data.name}</h4>
            <span class="position">{e.data.position}</span>
            {e.data.bio && <p style="padding: 0 20px 20px; font-size: 0.88rem; color: var(--text-secondary);">{e.data.bio}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ORGANIGRAMA 
  <section id="organigrama" class="section" style="background: var(--bg-warm);" aria-labelledby="org-title">
    <div class="container">
      <h2 class="section-title" id="org-title">Organigrama Institucional</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Estructura organizativa del CRAI </p>
      <div class="org-chart">
        {organigrama.map((level) => (
          <div class="org-level">
            {level.nodes.map((node) => {
              if (typeof node === 'object') {
                return (
                  <div class="org-branch">
                    <div class:list={['org-node', 'org-node-branch', level.level === 1 && 'level-1']}>{node.label}</div>
                    <div class="org-children">
                      {node.children.map((child) => (
                        <div class="org-node org-child">{child}</div>
                      ))}
                    </div>
                  </div>
                );
              }
              return <div class:list={['org-node', level.level === 1 && 'level-1']}>{node}</div>;
            })}
            {level.data.nodes.map((node) => (
              <div class:list={['org-node', level.data.level === 1 && 'level-1']}>{node}</div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section> -->

  <!-- CAMPUS Y SEDES -->
  <section id="campus" class="section" aria-labelledby="campus-title">
    <div class="container">
      <h2 class="section-title" id="campus-title">Campus y Sedes</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Nuestras instalaciones están distribuidas estratégicamente para brindar cobertura nacional</p>
      <div style="margin-top: 8px;">
        <iframe
          id="campus-map"
          class="campus-map"
          src="https://www.google.com/maps?q=C878%2BQ4Q%2C%20Pinar%20del%20R%C3%ADo%2C%20Cuba&z=16&hl=es&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          title="Mapa de la Universidad de Pinar del Río"></iframe>
      </div>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 32px;">
        {campus.map((c) => (
          <div
            class={`mvv-card reveal campus-card${c.default ? ' campus-active' : ''}`}
            style="text-align: left;"
            role="button"
            tabindex="0"
            data-campus-geo={c.geo}
            data-campus-name={c.name}>
            <h3 style="color: var(--primary); font-family: var(--font-title);"><i class={c.icon} aria-hidden="true" style="color: var(--secondary);"></i> {c.name}</h3>
            <p style="font-size: 0.9rem; color: var(--text-secondary);">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ACREDITACIONES -->
  <section id="acreditaciones" class="section" style="background: var(--bg-light);" aria-labelledby="acreditaciones-title">
    <div class="container">
      <h2 class="section-title" id="acreditaciones-title">Acreditaciones y Reconocimientos</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Certificaciones que avalan nuestra calidad institucional</p>
      <div class="content-grid">
        {acreditaciones.map((a) => (
          <div class="content-card reveal">
            <div class="content-card-icon"><i class={a.data.icon} aria-hidden="true"></i></div>
            <h3>{a.data.title}</h3>
            <p>{a.data.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DATOS RÁPIDOS -->
  <section class="stats-section" aria-labelledby="stats-title">
    <div class="container">
      <h2 class="section-title section-title--light" id="stats-title">La Universidad en Cifras</h2>
      <div class="section-divider" style="background: var(--secondary);" aria-hidden="true"></div>
      <p class="section-subtitle" style="color: rgba(255,255,255,0.8);">Más de cinco décadas formando profesionales que transforman el mundo</p>
      <div class="stats-grid">
        {stats.map((s) => (
          <div class="stat-item reveal">
            <span class="stat-number" data-target={s.data.target}>0</span><span class="stat-plus">{s.data.suffix}</span>
            <span class="stat-label">{s.data.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const mapFrame = document.getElementById('campus-map');
  const cards = Array.from(document.querySelectorAll('[data-campus-geo]'));

  const PLACE = '%2C%20Pinar%20del%20R%C3%ADo%2C%20Cuba';

  function showPlace(card) {
    const geo = card.getAttribute('data-campus-geo');
    if (!geo) return;
    mapFrame.setAttribute(
      'src',
      `https://www.google.com/maps?q=${geo}${PLACE}&z=16&hl=es&output=embed`
    );
    cards.forEach((c) => c.classList.toggle('campus-active', c === card));
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => showPlace(card));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        showPlace(card);
      }
    });
  });
</script>
