---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { getCollection } from 'astro:content';

const noticias = (await getCollection('noticias', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const eventos = await getCollection('eventos');

const avisos = [
  'Calendario académico 2026-2 publicado',
  'Convocatoria de becas vigente hasta el 15 de julio',
  'Suspensión de actividades por mantenimiento programado',
];

const formatDate = (d: Date | string) => new Date(d).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout title="Actualidad – CRAI" description="Noticias, eventos académicos, culturales y avisos oficiales de nuestra comunidad universitaria.">
  <PageHero
    badgeIcon="fa-bullhorn"
    badge="Actualidad"
    breadcrumb="Actualidad"
    title="Noticias y Eventos"
    subtitle="Mantente informado de todo lo que sucede en nuestra comunidad"
  />

  <!-- Noticias -->
  <Section id="noticias" title="Actualidad Universitaria" subtitle="Noticias, eventos académicos, culturales y avisos oficiales de nuestra comunidad">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {noticias.map((n) => (
        <article class="card-hover reveal flex flex-col overflow-hidden rounded-xl border border-border bg-white dark:border-slate-700 dark:bg-slate-800">
          <div class="bg-primary-500 text-white flex h-11 items-center justify-center text-2xl">
            <i class={n.data.icon}></i>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <span class="text-xs font-semibold uppercase text-secondary-500">{n.data.category}</span>
            <h3 class="mt-2 font-heading text-lg font-bold text-text dark:text-white">
              <a href={`/actualidad/${n.id}`} class="hover:text-primary-600 transition-colors">{n.data.title}</a>
            </h3>
            <p class="mt-3 line-clamp-3 text-sm text-text-secondary dark:text-gray-300">{n.data.description}</p>
            <p class="mt-auto pt-4 text-xs text-text-secondary dark:text-gray-400">{formatDate(n.data.pubDate)}</p>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <!-- Eventos -->
  <Section id="eventos" title="Próximos Eventos" subtitle="No te pierdas las actividades programadas por nuestra comunidad" light>
    <div class="grid gap-6 md:grid-cols-3">
      {eventos.map((e) => (
        <div class="card-hover reveal flex gap-4 rounded-xl border border-border bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
          <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-xl bg-primary-500 text-white">
            <span class="text-2xl font-extrabold leading-none">{e.data.day}</span>
            <span class="text-xs uppercase">{e.data.month}</span>
          </div>
          <div>
            <h3 class="font-heading font-bold text-text dark:text-white">{e.data.title}</h3>
            <p class="mt-2 text-sm text-text-secondary dark:text-gray-300"><i class="fas fa-map-marker-alt mr-1 text-primary-500"></i>{e.data.location}</p>
            <p class="mt-1 text-sm text-text-secondary dark:text-gray-300"><i class="fas fa-clock mr-1 text-primary-500"></i>{e.data.time}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- Avisos Oficiales -->
  <Section id="avisos" title="Avisos Oficiales" subtitle="Información institucional de interés general para la comunidad">
    <div class="mx-auto max-w-3xl">
      <ul class="space-y-4">
        {avisos.map((a) => (
          <li class="flex items-start gap-3 rounded-r-xl border-l-4 border-secondary-400 bg-white p-4 dark:bg-slate-800">
            <i class="fas fa-exclamation-circle mt-0.5 text-secondary-400"></i>
            <span class="text-text dark:text-gray-200">{a}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- Newsletter -->
  <Section id="newsletter" title="Boletín Informativo">
    <div class="bg-primary-600 rounded-2xl p-8 text-center text-white">
      <i class="fas fa-envelope-open-text mb-4 text-4xl text-white/80"></i>
      <h3 class="font-heading text-2xl font-bold">Recibe las últimas noticias y eventos</h3>
      <p class="mx-auto mt-3 max-w-xl text-white/80">Suscríbete para recibir noticias, eventos y avisos directamente en tu correo electrónico.</p>
      <form class="mx-auto mt-6 flex max-w-md flex-col gap-3 sm:flex-row" onsubmit="return false;">
        <input type="email" placeholder="Tu correo electrónico" class="flex-1 rounded-lg border-0 bg-white/10 px-4 py-3 text-white placeholder-white/70 outline-none ring-white/30 focus:ring-2" />
        <button type="submit" class="rounded-lg bg-white px-6 py-3 font-heading font-semibold text-primary-600 transition-opacity hover:opacity-90"><i class="fas fa-paper-plane mr-2"></i>Suscribirse</button>
      </form>
    </div>
  </Section>
</BaseLayout>
