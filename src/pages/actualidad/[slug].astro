---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((n) => ({ params: { slug: n.id }, props: { entry: n } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'noticias'> };
const { Content } = await render(entry);

const formatDate = (d: Date | string) => new Date(d).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={`${entry.data.title} – CRAI`} description={entry.data.description}>
  <main class="bg-gradient-to-br from-primary-700 via-primary-600 to-primary-800 py-14 text-white">
    <div class="container-crai">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-semibold backdrop-blur">
        <i class={`fas ${entry.data.icon}`}></i> {entry.data.category}
      </span>
      <h1 class="mt-4 font-heading text-3xl font-extrabold sm:text-4xl">{entry.data.title}</h1>
    </div>
  </main>

  <div class="container-crai py-14">
    <nav class="mb-8" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-text-secondary dark:text-gray-300">
        <li><a href="/" class="hover:text-primary-500">Inicio</a></li>
        <li><i class="fas fa-chevron-right text-[10px] text-text-secondary/50"></i></li>
        <li><a href="/actualidad" class="hover:text-primary-500">Actualidad</a></li>
      </ol>
    </nav>

    <article>
      <header class="mx-auto max-w-3xl">
        <h1 class="font-heading text-3xl font-extrabold text-text dark:text-white">{entry.data.title}</h1>
        <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-text-secondary dark:text-gray-400">
          <span class="inline-flex items-center">
            <i class="fas fa-user mr-2 text-primary-500"></i>{entry.data.author}
          </span>
          <span class="inline-flex items-center">
            <i class="fas fa-calendar-alt mr-2 text-primary-500"></i>{formatDate(entry.data.pubDate)}
          </span>
        </div>
      </header>

      <div class="prose-crai mx-auto mt-10 max-w-3xl">
        <Content />
      </div>

      <div class="mx-auto mt-12 max-w-3xl">
        <a href="/actualidad" class="inline-flex items-center gap-2 font-heading font-semibold text-primary-600 transition-colors hover:text-primary-700">
          <i class="fas fa-arrow-left"></i> Volver a Actualidad
        </a>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .prose-crai :global(h1),
  .prose-crai :global(h2),
  .prose-crai :global(h3),
  .prose-crai :global(h4),
  .prose-crai :global(h5),
  .prose-crai :global(h6) {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
    margin: 1.5em 0 0.5em;
  }
  .prose-crai :global(h1) { font-size: 2rem; margin-top: 0; }
  .prose-crai :global(h2) { font-size: 1.5rem; }
  .prose-crai :global(h3) { font-size: 1.25rem; }
  .prose-crai :global(h4) { font-size: 1.1rem; }
  .prose-crai :global(p) { color: var(--color-text); margin: 0 0 1.25em; line-height: 1.7; }
  .prose-crai :global(a) { color: var(--color-primary-600); text-decoration: underline; }
  .prose-crai :global(a:hover) { color: var(--color-primary-700); }
  .prose-crai :global(img) { max-width: 100%; height: auto; border-radius: 0.75rem; margin: 1.5em 0; }
  .prose-crai :global(ul) { list-style: disc; padding-left: 1.5em; margin: 0 0 1.25em; }
  .prose-crai :global(ol) { list-style: decimal; padding-left: 1.5em; margin: 0 0 1.25em; }
  .prose-crai :global(li) { margin: 0.4em 0; line-height: 1.6; }
  .prose-crai :global(blockquote) {
    border-left: 4px solid var(--color-secondary-400);
    padding: 0.75em 1.25em;
    margin: 1.5em 0;
    background: var(--color-surface-2);
    border-radius: 0 0.5rem 0.5rem 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }
  .prose-crai :global(strong) { font-weight: 700; }
  .prose-crai :global(code) { background: var(--color-surface-2); padding: 0.1em 0.35em; border-radius: 0.25rem; font-size: 0.9em; }
  .prose-crai :global(pre) { background: var(--color-slate-800); color: #fff; padding: 1em; border-radius: 0.5rem; overflow-x: auto; margin: 1.5em 0; }
</style>
