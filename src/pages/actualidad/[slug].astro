---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias', ({ data }) => !data.draft);
  return noticias.map((n) => ({ params: { slug: n.id }, props: { entry: n } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'noticias'> };
const { Content } = await render(entry);

const now = entry.data.pubDate;
const formatLong = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const formatShort = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });

const related = (await getCollection('noticias', ({ data }) => !data.draft && data.category === entry.data.category))
  .filter((n) => n.id !== entry.id)
  .slice(0, 3);
---

<BaseLayout title={`${entry.data.title} – CRAI`} description={entry.data.description}>
  <PageHero
    badge={`${entry.data.category}`}
    badgeIcon={entry.data.icon ?? 'fa-newspaper'}
    title={entry.data.title}
    subtitle={`Por ${entry.data.author} · ${formatLong(now)}`}
    crumb={entry.data.title}
  />

  <section class="section">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ul>
          <li><a href="/">Inicio</a></li>
          <li><a href="/actualidad">Actualidad</a></li>
          <li class="current">{entry.data.title}</li>
        </ul>
      </nav>

      <article class="article-body">
        <header class="article-header">
          <span class="news-category">{entry.data.category}</span>
          <h2 class="article-title">{entry.data.title}</h2>
          <div class="article-meta">
            <span><i class="fas fa-user" aria-hidden="true"></i> {entry.data.author}</span>
            <span><i class="fas fa-calendar-alt" aria-hidden="true"></i> {formatShort(now)}</span>
          </div>
        </header>

        <Content />

        <div class="article-back">
          <a href="/actualidad" class="btn btn-outline"><i class="fas fa-arrow-left" aria-hidden="true"></i> Volver a Actualidad</a>
        </div>
      </article>

      {related.length > 0 && (
        <div class="related-posts">
          <h3 class="related-title">Noticias Relacionadas</h3>
          <div class="related-grid">
            {related.map((r) => (
              <a href={`/actualidad/${r.id}`} class="related-card">
                <i class={r.data.icon ?? 'fas fa-newspaper'} aria-hidden="true"></i>
                <h4>{r.data.title}</h4>
                <span>{formatShort(r.data.pubDate)}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .article-body {
    max-width: 780px;
    margin: 0 auto;
    padding: 1rem 0;
  }
  .article-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.5rem;
  }
  .article-title {
    font-family: var(--font-title);
    font-size: 1.8rem;
    line-height: 1.3;
    margin: 0.5rem 0;
  }
  .article-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    flex-wrap: wrap;
  }
  .article-meta span {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }
  .article-body :global(p) {
    color: var(--text-primary);
    line-height: 1.8;
    margin: 0 0 1.25em;
  }
  .article-body :global(h1),
  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4) {
    font-family: var(--font-title);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 1.5em 0 0.5em;
  }
  .article-body :global(h1) { font-size: 1.5rem; }
  .article-body :global(h2) { font-size: 1.35rem; }
  .article-body :global(h3) { font-size: 1.2rem; }
  .article-body :global(a) { color: var(--primary); text-decoration: underline; }
  .article-body :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-md); margin: 1.5em 0; }
  .article-body :global(ul) { list-style: disc; padding-left: 1.5em; margin: 0 0 1.25em; }
  .article-body :global(ol) { list-style: decimal; padding-left: 1.5em; margin: 0 0 1.25em; }
  .article-body :global(li) { margin: 0.4em 0; line-height: 1.7; }
  .article-body :global(blockquote) {
    border-left: 4px solid var(--secondary);
    padding: 0.75em 1.25em;
    margin: 1.5em 0;
    background: var(--bg-light);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--text-secondary);
    font-style: italic;
  }
  .article-body :global(code) { background: var(--bg-light); padding: 0.1em 0.35em; border-radius: var(--radius-sm); font-size: 0.9em; }
  .article-body :global(pre) { background: var(--primary-dark); color: var(--text-light); padding: 1em; border-radius: var(--radius-sm); overflow-x: auto; margin: 1.5em 0; }

  .article-back {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .related-posts {
    max-width: 780px;
    margin: 3rem auto 0;
    padding-top: 2rem;
    border-top: 2px solid var(--border-color);
  }
  .related-title {
    font-family: var(--font-title);
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .related-card {
    background: var(--bg-white);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 16px;
    transition: var(--transition);
    color: var(--text-primary);
  }
  .related-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--secondary-light);
  }
  .related-card i {
    color: var(--primary);
    font-size: 1.3rem;
    margin-bottom: 8px;
  }
  .related-card h4 {
    font-family: var(--font-title);
    font-size: 0.95rem;
    line-height: 1.4;
    margin-bottom: 6px;
  }
  .related-card span {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
