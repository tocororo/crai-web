---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionIcons from '../components/SectionIcons.astro';
import { getCollection } from 'astro:content';

const byOrder = (a: { data: { order?: number } }, b: { data: { order?: number } }) => (a.data.order ?? 0) - (b.data.order ?? 0);

const steps = (await getCollection('admision-pasos')).sort(byOrder);
const requisitos = (await getCollection('admision-requisitos')).sort(byOrder);
const becas = (await getCollection('becas')).sort(byOrder);
const calendario = (await getCollection('calendario-academico')).sort(byOrder);
const faq = (await getCollection('faq')).sort(byOrder);
---

<BaseLayout title="Admisión - CRAI" description="Proceso de admisión al CRAI. Conoce los pasos, requisitos, calendario académico y opciones de becas disponibles.">
  <!-- HERO MODERNO S/FOTO -->
  <section class="hero hero--compact" aria-label="Admisión">
    <div class="hero-bg hero-bg--plain"></div>
    <div class="hero-overlay"></div>
    <div class="hero-symbols" aria-hidden="true">
      <i class="fas fa-door-open hero-glyph hs-1"></i>
      <i class="fas fa-list-check hero-glyph hs-2"></i>
      <i class="fas fa-graduation-cap hero-glyph hs-3"></i>
      <i class="fas fa-calendar-days hero-glyph hs-4"></i>
      <i class="fas fa-clipboard-list hero-glyph hs-5"></i>
      <i class="fas fa-circle-question hero-glyph hs-6"></i>
      <i class="fas fa-envelope hero-glyph hs-7"></i>
      <i class="fas fa-phone hero-glyph hs-8"></i>
      <i class="fas fa-map-location-dot hero-glyph hs-9"></i>
    </div>
    <div class="hero-particles" aria-hidden="true">
      <div class="hero-particle" style="--x:15%;--y:20%;--s:60px;--d:0s;"></div>
      <div class="hero-particle" style="--x:80%;--y:30%;--s:40px;--d:2s;"></div>
      <div class="hero-particle" style="--x:25%;--y:70%;--s:50px;--d:4s;"></div>
      <div class="hero-particle" style="--x:70%;--y:65%;--s:35px;--d:1s;"></div>
      <div class="hero-particle" style="--x:50%;--y:15%;--s:45px;--d:3s;"></div>
      <div class="hero-particle" style="--x:10%;--y:50%;--s:30px;--d:5s;"></div>
      <div class="hero-particle" style="--x:90%;--y:55%;--s:55px;--d:2.5s;"></div>
      <div class="hero-particle" style="--x:45%;--y:85%;--s:25px;--d:4.5s;"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge-wrapper">
        <span class="hero-badge">
          <img src="/images/305464304_448374310649340_2984277522454001566_n-Photoroom.png" alt="Logo UPR" class="univ-hero-logo" />
          Proceso de Ingreso
        </span>
      </div>
      <h1 class="hero-title univ-hero-title">Proceso de Admisión</h1>
      <p class="hero-subtitle">Tu futuro comienza aquí. Te guiamos en cada paso del proceso</p>
    </div>
  </section>

  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ul>
        <li><a href="/">Inicio</a></li>
        <li class="current" aria-current="page">Admisión</li>
      </ul>
    </div>
  </nav>

  <!-- PASOS DE ADMISIÓN -->
  <section class="section" aria-labelledby="pasos-title">
    <SectionIcons icons={['fa-graduation-cap', 'fa-list-check', 'fa-door-open']} />
    <div class="container">
      <span class="section-eyebrow">Proceso</span>
      <h2 class="section-title" id="pasos-title">Pasos para tu Admisión</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Sigue estos sencillos pasos para completar tu proceso de admisión</p>
      <div class="steps">
        {steps.map((step) => (
          <div class="step-card reveal">
            <div class="step-number">{step.data.number}</div>
            <div class="step-icon"><i class={`fas ${step.data.icon}`}></i></div>
            <h3>{step.data.title}</h3>
            <p>{step.data.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CALENDARIO ACADÉMICO -->
  <section id="calendario" class="section section--border-top" aria-labelledby="calendario-title">
    <SectionIcons icons={['fa-calendar-days', 'fa-clock', 'fa-book-open']} align="left" />
    <div class="container">
      <span class="section-eyebrow">Fechas</span>
      <h2 class="section-title" id="calendario-title">Calendario Académico</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Fechas clave para el próximo ciclo académico</p>
      <div class="timeline">
        {calendario.map((row) => (
          <div class="timeline-item reveal">
            <div class="timeline-dot"></div>
            <div class="timeline-content">
              <span class="timeline-date">{row.data.inicio}</span>
              <h3>{row.data.evento}</h3>
              <p>{row.data.cierre}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REQUISITOS POR NIVEL -->
  <section id="requisitos" class="section" style="background: var(--bg-light);" aria-labelledby="requisitos-title">
    <SectionIcons icons={['fa-clipboard-list', 'fa-file-lines', 'fa-folder-open']} />
    <div class="container">
      <span class="section-eyebrow">Requisitos</span>
      <h2 class="section-title" id="requisitos-title">Requisitos por Nivel</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Cada nivel académico tiene requisitos específicos. Consulta los detalles a continuación</p>
      <div class="requirements-grid">
        {requisitos.map((req) => (
          <div class="req-card reveal">
            <div class="req-icon"><i class={`fas ${req.data.icon}`}></i></div>
            <h3>{req.data.title}</h3>
            <ul>{req.data.requisitos.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- PREGUNTAS FRECUENTES -->
  <section id="faq" class="section" aria-labelledby="faq-title">
    <SectionIcons icons={['fa-circle-question', 'fa-life-ring', 'fa-comments']} align="left" />
    <div class="container">
      <span class="section-eyebrow">Dudas</span>
      <h2 class="section-title" id="faq-title">Preguntas Frecuentes</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Resolvemos tus dudas sobre el proceso de admisión</p>
      <div class="faq-grid">
        {faq.map((item) => (
          <div class="faq-item reveal">
            <button class="faq-question" aria-expanded="false">
              <span>{item.data.question}</span>
              <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="faq-answer">
              <p>{item.data.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section" style="background: var(--bg-light);" aria-labelledby="contacto-title">
    <SectionIcons icons={['fa-map-location-dot', 'fa-phone', 'fa-envelope']} />
    <div class="container">
      <span class="section-eyebrow">Contacto</span>
      <h2 class="section-title" id="contacto-title">Contáctanos</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">¿Tienes más preguntas? Escríbenos y te responderemos a la brevedad</p>
      <div class="contact-wrapper">
        <form id="contact-form" class="contact-form">
          <div class="form-group">
            <label for="nombre">Nombre completo</label>
            <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required />
          </div>
          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" placeholder="tucorreo@ejemplo.com" required />
          </div>
          <div class="form-group">
            <label for="mensaje">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="5" placeholder="Escribe tu mensaje aquí..." required></textarea>
          </div>
          <button type="submit" class="btn btn-gold">Enviar mensaje</button>
        </form>
        <div id="form-success" class="form-success" style="display: none;">
          <i class="fas fa-check-circle"></i>
          <h3>¡Mensaje enviado con éxito!</h3>
          <p>Gracias por contactarnos. Te responderemos a la brevedad posible.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
