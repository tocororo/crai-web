---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const steps = [
  { number: 1, icon: 'fa-search', title: 'Investigación de Programas', description: 'Explora nuestra oferta académica y encuentra el programa que mejor se alinee con tus intereses y metas profesionales.' },
  { number: 2, icon: 'fa-file-alt', title: 'Preparación de Documentos', description: 'Reúne todos los documentos requeridos: certificados de estudios, identificación oficial, ensayos y cartas de recomendación.' },
  { number: 3, icon: 'fa-laptop', title: 'Presentación de Solicitud', description: 'Completa el formulario de solicitud en línea y sube los documentos requeridos en nuestro portal de admisiones.' },
  { number: 4, icon: 'fa-handshake', title: 'Entrevista y Admisión', description: 'Si tu solicitud es preseleccionada, serás contactado para una entrevista. Recibirás la notificación de admisión por correo electrónico.' },
];

const requisitosGrado = ['Título de educación secundaria o equivalente', 'Certificado de notas oficial', 'Documento de identidad oficial', 'Ensayo personal', 'Carta de recomendación', 'Examen de admisión'];
const requisitosPosgrado = ['Título universitario oficial', 'Certificado de notas de grado', 'Currículum vitae actualizado', 'Propuesta de investigación', 'Dos cartas de recomendación', 'Entrevista personal'];
const requisitosDoctorado = ['Título de maestría o equivalente', 'Certificado de notas de posgrado', 'Currículum vitae académico', 'Anteproyecto de tesis doctoral', 'Tres cartas de recomendación', 'Entrevista con el comité académico'];

const becas = [
  { icon: 'fa-star', title: 'Beca al Mérito Académico', description: 'Otorgada a estudiantes con expedientes académicos sobresalientes. Cubre hasta el 100% de la matrícula durante toda la carrera.' },
  { icon: 'fa-users', title: 'Beca Socioeconómica', description: 'Dirigida a estudiantes con limitaciones económicas que demuestren alto potencial académico. Incluye apoyo para matrícula y materiales.' },
  { icon: 'fa-running', title: 'Beca Deportiva', description: 'Para atletas de alto rendimiento que representen a la universidad en competencias oficiales. Cubre matrícula y alojamiento.' },
  { icon: 'fa-globe-americas', title: 'Beca de Internacionalización', description: 'Apoyo económico para estudiantes que participen en programas de intercambio o movilidad académica en universidades extranjeras.' },
  { icon: 'fa-lightbulb', title: 'Beca de Investigación', description: 'Destinada a estudiantes de posgrado y doctorado que desarrollen proyectos de investigación innovadores con impacto social.' },
  { icon: 'fa-hand-holding-heart', title: 'Programa de Ayuda Financiera', description: 'Planes de pago flexibles y préstamos universitarios con tasas preferenciales para garantizar el acceso a la educación superior.' },
];

const calendario = [
  { evento: 'Apertura de inscripciones', inicio: '1 de febrero de 2026', cierre: '31 de mayo de 2026' },
  { evento: 'Envío de documentos', inicio: '1 de febrero de 2026', cierre: '15 de junio de 2026' },
  { evento: 'Examen de admisión', inicio: '15 de marzo de 2026', cierre: '30 de junio de 2026' },
  { evento: 'Entrevistas', inicio: '1 de abril de 2026', cierre: '15 de julio de 2026' },
  { evento: 'Publicación de resultados', inicio: '1 de agosto de 2026', cierre: '—' },
  { evento: 'Matrícula', inicio: '15 de agosto de 2026', cierre: '31 de agosto de 2026' },
  { evento: 'Inicio de clases', inicio: '1 de septiembre de 2026', cierre: '—' },
];

const faq = [
  { q: '¿Cuándo abre el período de inscripciones?', a: 'El período de inscripciones abre el 1 de febrero de cada año y se extiende hasta el 31 de mayo. Te recomendamos presentar tu solicitud lo antes posible, ya que algunos programas tienen cupos limitados.' },
  { q: '¿Qué documentos necesito presentar?', a: 'Los documentos varían según el nivel académico. En general, necesitarás tu título o certificado de estudios, documento de identidad, ensayo personal y cartas de recomendación. Consulta la sección de Requisitos por Nivel para más detalles.' },
  { q: '¿Hay examen de admisión?', a: 'Sí, para ingresar a programas de grado es necesario presentar el examen de admisión general. Para posgrado y doctorado, la evaluación incluye la revisión del expediente académico y una entrevista personal.' },
  { q: '¿Ofrecen becas deportivas?', a: 'Sí, contamos con un programa de becas deportivas para atletas de alto rendimiento. Cubren matrícula y alojamiento, y requieren que el becado represente a la universidad en competencias oficiales.' },
  { q: '¿Puedo transferirme de otra universidad?', a: 'Sí, aceptamos transferencias de otras instituciones de educación superior. Debes presentar tus certificados de notas, los programas de estudios cursados y someterte a una evaluación de convalidación de materias.' },
];
---

<BaseLayout title="Admisión - CRAI" description="Proceso de admisión al CRAI. Conoce los pasos, requisitos, calendario académico y opciones de becas disponibles.">
  <PageHero
    badgeIcon="fa-door-open"
    badge="Proceso de Ingreso"
    title="Proceso de Admisión"
    subtitle="Tu futuro comienza aquí. Te guiamos en cada paso del proceso"
    crumb="Admisión"
  />

  <!-- PASOS DE ADMISIÓN -->
  <section class="section" aria-labelledby="pasos-title">
    <div class="container">
      <h2 class="section-title" id="pasos-title">Pasos para tu Admisión</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Sigue estos sencillos pasos para completar tu proceso de admisión</p>
      <div class="steps">
        {steps.map((step) => (
          <div class="step-card reveal">
            <div class="step-number">{step.number}</div>
            <div class="step-icon"><i class={`fas ${step.icon}`}></i></div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CALENDARIO ACADÉMICO -->
  <section id="calendario" class="section" style="background: var(--bg-light);" aria-labelledby="calendario-title">
    <div class="container">
      <h2 class="section-title" id="calendario-title">Calendario Académico</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Fechas clave para el próximo ciclo académico</p>
      <div class="table-responsive">
        <table class="academic-calendar">
          <thead>
            <tr>
              <th>Evento</th>
              <th>Fecha de Inicio</th>
              <th>Fecha de Cierre</th>
            </tr>
          </thead>
          <tbody>
            {calendario.map((row) => (
              <tr>
                <td>{row.evento}</td>
                <td>{row.inicio}</td>
                <td>{row.cierre}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- REQUISITOS POR NIVEL -->
  <section id="requisitos" class="section" aria-labelledby="requisitos-title">
    <div class="container">
      <h2 class="section-title" id="requisitos-title">Requisitos por Nivel</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Cada nivel académico tiene requisitos específicos. Consulta los detalles a continuación</p>
      <div class="requirements-grid">
        <div class="req-card reveal">
          <div class="req-icon"><i class="fas fa-graduation-cap"></i></div>
          <h3>Grado</h3>
          <ul>{requisitosGrado.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="req-card reveal">
          <div class="req-icon"><i class="fas fa-book-open"></i></div>
          <h3>Posgrado</h3>
          <ul>{requisitosPosgrado.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="req-card reveal">
          <div class="req-icon"><i class="fas fa-flask"></i></div>
          <h3>Doctorado</h3>
          <ul>{requisitosDoctorado.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- BECAS Y AYUDAS FINANCIERAS -->
  <section id="becas" class="section" style="background: var(--bg-warm);" aria-labelledby="becas-title">
    <div class="container">
      <h2 class="section-title" id="becas-title">Becas y Ayudas Financieras</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Ofrecemos diversas opciones para hacer tu educación accesible</p>
      <div class="scholarships-grid">
        {becas.map((beca) => (
          <div class="scholarship-card reveal">
            <div class="scholarship-icon"><i class={`fas ${beca.icon}`}></i></div>
            <h3>{beca.title}</h3>
            <p>{beca.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PREGUNTAS FRECUENTES -->
  <section id="faq" class="section" aria-labelledby="faq-title">
    <div class="container">
      <h2 class="section-title" id="faq-title">Preguntas Frecuentes</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Resolvemos tus dudas sobre el proceso de admisión</p>
      <div class="faq-grid">
        {faq.map((item) => (
          <div class="faq-item reveal">
            <button class="faq-question" aria-expanded="false">
              <span>{item.q}</span>
              <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section" style="background: var(--bg-light);" aria-labelledby="contacto-title">
    <div class="container">
      <h2 class="section-title" id="contacto-title">Contáctanos</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">¿Tienes más preguntas? Escríbenos y te responderemos a la brevedad</p>
      <div class="contact-wrapper">
        <form id="contact-form" class="contact-form">
          <div class="form-group">
            <label for="nombre">Nombre completo</label>
            <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required />
          </div>
          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" placeholder="tucorreo@ejemplo.com" required />
          </div>
          <div class="form-group">
            <label for="mensaje">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="5" placeholder="Escribe tu mensaje aquí..." required></textarea>
          </div>
          <button type="submit" class="btn btn-gold">Enviar mensaje</button>
        </form>
        <div id="form-success" class="form-success" style="display: none;">
          <i class="fas fa-check-circle"></i>
          <h3>¡Mensaje enviado con éxito!</h3>
          <p>Gracias por contactarnos. Te responderemos a la brevedad posible.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
