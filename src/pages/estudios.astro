---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';

const carrerasAsignaturas = (await getCollection('carreras-asignaturas'))
  .filter((c) => c.data.carrera === 'Licenciatura en Ciencias de la Información')
  .sort((a, b) => (a.data.año ?? 0) - (b.data.año ?? 0) || (a.data.order ?? 0) - (b.data.order ?? 0));

const carrerasAsignaturasAll = (await getCollection('carreras-asignaturas'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const yearLabels: Record<number, string> = {
  1: '1er año',
  2: '2do año',
  3: '3er año',
  4: '4to año',
  5: '5to año',
};

const intercambio = (await getCollection('intercambio')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const asignaturasServicio = (await getCollection('asignaturas-servicio')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---
<BaseLayout title="Asignaturas de la Carrera — CRAI" description="Explora las asignaturas de la Licenciatura en Ciencias de la Información en modalidad Curso por Encuentro.">
  <PageHero
    badgeIcon="fa-book-open"
    badge="Licenciatura en Ciencias de la Información"
    title="Asignaturas — Curso por Encuentro"
    subtitle="5 años de formación integral en gestión documental, investigación y organización de la información"
    crumb="Estudios"
  />

  <!-- Program Search -->
  <section class="section section-search" aria-labelledby="search-title">
    <div class="container">
<h2 class="section-title" id="search-title">Busca tu materia ideal</h2>
       <div class="section-divider" aria-hidden="true"></div>
       <div class="search-controls">
         <div class="search-box">
           <input type="text" id="program-search-input" placeholder="Buscar materias..." aria-label="Buscar materias" />
          <button id="program-search-btn" aria-label="Buscar"><i class="fas fa-search"></i></button>
        </div>
        <div class="filter-buttons">
          <button class="filter-btn active" data-filter="all">Todos</button>
          <button class="filter-btn" data-filter="1">1er año</button>
          <button class="filter-btn" data-filter="2">2do año</button>
          <button class="filter-btn" data-filter="3">3er año</button>
          <button class="filter-btn" data-filter="4">4to año</button>
          <button class="filter-btn" data-filter="5">5to año</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Asignaturas Listing -->
  <section id="grado" class="section section--border-top" aria-labelledby="programas-title">
    <div class="container">
      <h2 class="section-title" id="programas-title">Asignaturas de la Licenciatura en Ciencias de la Información</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Curso por Encuentro — 5 años de formación integral en Ciencias de la Información</p>
      <div class="program-list">
        {carrerasAsignaturas.map((c) => (
          <div class="program-list-item" data-category={c.data.año}>
            <div class="program-list-info">
              <h3>{c.data.materia}</h3>
              <p class="asignatura-desc">{c.data.descripcion}</p>
              <div class="program-meta">
                <span><i class="fas fa-calendar-alt" aria-hidden="true"></i> {yearLabels[c.data.año] ?? c.data.año + '° año'}</span>
                <span><i class="fas fa-layer-group" aria-hidden="true"></i> {c.data.disciplina}</span>
                <span><i class="fas fa-clock" aria-hidden="true"></i> {c.data.horas} hrs</span>
                <span><i class="fas fa-book" aria-hidden="true"></i> Curso por Encuentro</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

   <!-- Asignaturas de Servicio -->
   <section class="section section--border-top" id="asignaturas-servicio" aria-labelledby="asignaturas-title">
    <div class="container">
      <h2 class="section-title" id="asignaturas-title">Asignaturas de Servicio</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Formación en competencias informacionales para toda la comunidad estudiantil</p>

        <div class="asignaturas-grid">
        {asignaturasServicio.map((a) => (
          <div class="asignatura-service-card">
            <div class="asignatura-service-icon"><i class="fas fa-book-open"></i></div>
            <h3>{a.data.title}</h3>
            <p class="asignatura-modalidad"><i class="fas fa-clock" aria-hidden="true"></i> {a.data.modalidad}</p>
          </div>
        ))}
      </div>

      <div class="table-wrapper">
        <table class="asignaturas-table" aria-label="Asignaturas de servicio por carrera">
          <thead>
            <tr>
              <th>Carrera</th>
              <th>Materia</th>
              <th class="text-center">Horas</th>
            </tr>
          </thead>
          <tbody>
             {carrerasAsignaturasAll.map((c, i) => (
              <tr class:list={[i % 2 === 1 && 'alt']}>
                <td>{c.data.carrera}</td>
                <td>{c.data.materia}</td>
                <td class="text-center">{c.data.horas}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

   <!-- Programas de Intercambio 
   <section class="section" id="intercambio" aria-labelledby="intercambio-title">
     <div class="container">
       <h2 class="section-title" id="intercambio-title">Programas de Intercambio</h2>
       <div class="section-divider" aria-hidden="true"></div>
       <p class="section-subtitle">Amplía tus horizontes académicos y culturales en universidades de todo el mundo</p>
       <div class="content-grid">
         {intercambio.map((i) => (
           <div class="content-card reveal">
             <div class="content-card-icon"><i class={i.data.icon}></i></div>
             <h3>{i.data.title}</h3>
             <p>{i.data.desc}</p>
           </div>
         ))}
       </div>
       <div class="text-center" style="margin-top: 2rem;">
         <a href="#" class="btn btn-gold"><i class="fas fa-globe"></i> Más información sobre intercambios</a>
       </div>
     </div>
   </section> -->

</BaseLayout>
