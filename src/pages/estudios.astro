---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionIcons from '../components/SectionIcons.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../lib/content';

const carrerasAsignaturas = (await getCollection('materias-licenciatura'))
  .filter((c) => c.data.carrera === 'Licenciatura en Ciencias de la Información')
  .sort((a, b) => (a.data.año ?? 0) - (b.data.año ?? 0) || (a.data.order ?? 0) - (b.data.order ?? 0));

const servicioCarreras = (await getCollection('servicio-carreras'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const yearLabels: Record<number, string> = {
  1: '1er año',
  2: '2do año',
  3: '3er año',
  4: '4to año',
  5: '5to año',
};

const asignaturasServicio = (await getCollection('asignaturas-servicio')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const buscadores = (await getCollection('buscadores')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const accessLabel: Record<string, string> = {
  abierto: 'Acceso abierto',
  mixto: 'Acceso mixto',
  institucional: 'Acceso institucional',
};
---
<BaseLayout title="Materias de la Carrera — CRAI" description="Explora las asignaturas de la Licenciatura en Ciencias de la Información en modalidad Curso por Encuentro.">
  <!-- HERO CON FOTO: formación académica -->
  <section class="hero hero--compact" aria-label="Estudios">
    <div
      class="hero-bg"
      style="background-image: url('/images/hero-estudios.jpg'); background-color: #012D17;"
    ></div>
    <div class="hero-overlay"></div>
    <div class="hero-symbols" aria-hidden="true">
      <i class="fas fa-magnifying-glass hero-glyph hs-1"></i>
      <i class="fas fa-book-open hero-glyph hs-2"></i>
      <i class="fas fa-filter hero-glyph hs-3"></i>
      <i class="fas fa-book hero-glyph hs-4"></i>
      <i class="fas fa-barcode hero-glyph hs-5"></i>
      <i class="fas fa-graduation-cap hero-glyph hs-6"></i>
      <i class="fas fa-chalkboard-user hero-glyph hs-7"></i>
      <i class="fas fa-users hero-glyph hs-8"></i>
      <i class="fas fa-clock hero-glyph hs-9"></i>
    </div>
    <div class="hero-particles" aria-hidden="true">
      <div class="hero-particle" style="--x:15%;--y:20%;--s:60px;--d:0s;"></div>
      <div class="hero-particle" style="--x:80%;--y:30%;--s:40px;--d:2s;"></div>
      <div class="hero-particle" style="--x:25%;--y:70%;--s:50px;--d:4s;"></div>
      <div class="hero-particle" style="--x:70%;--y:65%;--s:35px;--d:1s;"></div>
      <div class="hero-particle" style="--x:50%;--y:15%;--s:45px;--d:3s;"></div>
      <div class="hero-particle" style="--x:10%;--y:50%;--s:30px;--d:5s;"></div>
      <div class="hero-particle" style="--x:90%;--y:55%;--s:55px;--d:2.5s;"></div>
      <div class="hero-particle" style="--x:45%;--y:85%;--s:25px;--d:4.5s;"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge-wrapper">
        <span class="hero-badge">
          <img src="/images/logo-crai.png" alt="Logo UPR" class="univ-hero-logo" />
          Licenciatura en Ciencias de la Información
        </span>
      </div>
      <h1 class="hero-title univ-hero-title">Formación Académica</h1>
      <p class="hero-subtitle">5 años de formación integral en gestión documental, investigación y organización de la información</p>
    </div>
  </section>

  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <div class="container">
      <ul>
        <li><a href="/">Inicio</a></li>
        <li class="current" aria-current="page">Estudios</li>
      </ul>
    </div>
  </nav>

  <!-- Program Search -->
  <section class="section section-search" aria-labelledby="search-title">
    <SectionIcons icons={['fa-magnifying-glass', 'fa-book-open', 'fa-filter']} />
    <div class="container">
      <span class="section-eyebrow">Búsqueda</span>
      <h2 class="section-title" id="search-title">Busca tu materia ideal</h2>
       <div class="section-divider" aria-hidden="true"></div>
       <div class="search-controls">
         <div class="search-box">
           <input type="text" id="program-search-input" placeholder="Buscar materias..." aria-label="Buscar materias" />
           <button id="program-search-btn" aria-label="Buscar"><i class="fas fa-search"></i></button>
        </div>
        <p class="search-feedback" id="search-feedback" role="status" aria-live="polite"></p>
        <div class="filter-buttons">
          <button class="filter-btn active" data-filter="all">Todos</button>
          <button class="filter-btn" data-filter="1">1er año</button>
          <button class="filter-btn" data-filter="2">2do año</button>
          <button class="filter-btn" data-filter="3">3er año</button>
          <button class="filter-btn" data-filter="4">4to año</button>
          <button class="filter-btn" data-filter="5">5to año</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Asignaturas Listing -->
  <section id="grado" class="section section--border-top" aria-labelledby="programas-title">
    <SectionIcons icons={['fa-book-open', 'fa-book', 'fa-barcode']} align="left" />
    <div class="container">
      <span class="section-eyebrow">Plan de Estudios</span>
      <h2 class="section-title" id="programas-title">Materias de la Licenciatura en Ciencias de la Información</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Curso por Encuentro — 5 años de formación integral en Ciencias de la Información</p>
      <div class="program-list">
        {carrerasAsignaturas.map((c) => (
          <div class="program-list-item" data-category={c.data.año}>
            <div class="program-list-info">
              <h3>{c.data.materia}</h3>
              <p class="asignatura-desc">{c.data.descripcion}</p>
              <div class="program-meta">
                <span><i class="fas fa-calendar-alt" aria-hidden="true"></i> {yearLabels[c.data.año] ?? c.data.año + '° año'}</span>
                <span><i class="fas fa-layer-group" aria-hidden="true"></i> {c.data.disciplina}</span>
                <span><i class="fas fa-clock" aria-hidden="true"></i> {c.data.horas} hrs</span>
                <span><i class="fas fa-book" aria-hidden="true"></i> Curso por Encuentro</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="program-empty" id="program-empty" hidden>
        <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
        No encontramos materias con ese criterio. Prueba con otro término o selecciona «Todos».
      </p>
      <div class="pagination-wrapper" id="pagination-wrapper">
        <button class="pagination-btn" id="pagination-prev" aria-label="Página anterior"><i class="fas fa-chevron-left"></i></button>
        <div class="pagination-pages" id="pagination-pages"></div>
        <button class="pagination-btn" id="pagination-next" aria-label="Página siguiente"><i class="fas fa-chevron-right"></i></button>
      </div>
    </div>
  </section>

  <!-- Asignaturas de Servicio -->
   <section class="section section--border-top" id="asignaturas-servicio" aria-labelledby="asignaturas-title">
    <SectionIcons icons={['fa-graduation-cap', 'fa-chalkboard-user', 'fa-users']} />
    <div class="container">
      <span class="section-eyebrow">Servicio</span>
      <h2 class="section-title" id="asignaturas-title">Asignaturas de Servicio</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Formación en competencias informacionales para toda la comunidad estudiantil</p>

        <div class="asignaturas-grid">
        {asignaturasServicio.map((a) => (
          <div class="asignatura-service-card">
            <div class="asignatura-service-icon"><i class="fas fa-book-open"></i></div>
            <h3>{a.data.title}</h3>
            <p class="asignatura-modalidad"><i class="fas fa-clock" aria-hidden="true"></i> {a.data.modalidad}</p>
          </div>
        ))}
      </div>

      <div class="table-wrapper">
        <table class="asignaturas-table" aria-label="Asignaturas de servicio por carrera">
          <thead>
            <tr>
              <th>Carrera</th>
              <th>Materia</th>
              <th class="text-center">Horas</th>
            </tr>
          </thead>
          <tbody>
             {servicioCarreras.map((c, i) => (
              <tr class:list={[i % 2 === 1 && 'alt']}>
                <td>{c.data.carrera}</td>
                <td>{c.data.materia}</td>
                <td class="text-center">{c.data.horas}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="servicio-cta">
        <div class="servicio-cta-text">
          <h3>¿Vas a investigar?</h3>
          <p>Descubre los buscadores y bases de datos recomendados para encontrar literatura científica y fuentes confiables.</p>
        </div>
        <a class="btn btn-primary" href="#buscadores">
          <i class="fas fa-magnifying-glass-chart" aria-hidden="true"></i> Ver buscadores
        </a>
      </div>
    </div>
</section>

<section id="buscadores" class="section section--border-top section-engines" aria-labelledby="buscadores-title">
  <SectionIcons icons={['fa-magnifying-glass-chart', 'fa-database', 'fa-book-open-reader']} align="left" />
  <div class="container">
    <span class="section-eyebrow">Recursos para investigar</span>
    <h2 class="section-title" id="buscadores-title">Buscadores y bases de datos</h2>
    <div class="section-divider" aria-hidden="true"></div>
    <p class="section-subtitle">Herramientas recomendadas para encontrar artículos, datos y fuentes confiables en tus investigaciones. Explóralas por categoría.</p>

    <div class="engine-filters" role="tablist" aria-label="Filtrar buscadores por categoría">
      <button type="button" class="engine-filter active" data-engine-filter="all">
        <i class="fas fa-layer-group" aria-hidden="true"></i> Todas
      </button>
      {buscadores.map((c) => (
        <button type="button" class="engine-filter" data-engine-filter={c.id}>
          <i class={c.data.icon} aria-hidden="true"></i> {c.data.title}
        </button>
      ))}
    </div>

    <div class="engine-groups">
      {buscadores.map((c) => (
        <div class="engine-group" data-engine-category={c.id}>
          <div class="engine-group-head">
            <div class="engine-group-icon"><i class={c.data.icon} aria-hidden="true"></i></div>
            <div class="engine-group-text">
              <h3>{c.data.title}</h3>
              {c.data.desc && <p>{c.data.desc}</p>}
            </div>
          </div>
          <div class="engine-grid">
            {c.data.items.map((it) => (
              <article class="engine-card" id={`engine-${slugify(it.name)}`}>
                <div class="engine-card-logo">
                  {it.logo ? (
                    <img src={it.logo} alt={`Logo de ${it.name}`} loading="lazy" decoding="async" />
                  ) : (
                    <span class="engine-card-monogram" aria-hidden="true">{it.name.charAt(0)}</span>
                  )}
                </div>
                <div class="engine-card-body">
                  <div class="engine-card-top">
                    <h4>{it.name}</h4>
                    <span class={`engine-access engine-access--${it.access}`}>
                      <i class="fas fa-lock" aria-hidden="true"></i> {accessLabel[it.access]}
                    </span>
                  </div>
                  <p class="engine-card-desc">{it.desc}</p>
                  {it.tip && (
                    <p class="engine-card-tip">
                      <i class="fas fa-lightbulb" aria-hidden="true"></i>
                      <span>{it.tip}</span>
                    </p>
                  )}
                  <a class="engine-card-link" href={it.url} target="_blank" rel="noopener noreferrer">
                    Visitar buscador <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="engine-cheatsheet reveal">
      <div class="engine-cheatsheet-head">
        <div class="engine-cheatsheet-icon"><i class="fas fa-graduation-cap" aria-hidden="true"></i></div>
        <div>
          <h3>Cómo buscar mejor</h3>
          <p>Combina estos operadores en cualquier buscador académico para obtener resultados más precisos.</p>
        </div>
      </div>
      <div class="engine-cheatsheet-grid">
        <div class="engine-op"><code>&quot;frase exacta&quot;</code><p>Encuentra esas palabras juntas y en ese orden.</p></div>
        <div class="engine-op"><code>AND</code><p>Obliga a que aparezcan <strong>todos</strong> los términos.</p></div>
        <div class="engine-op"><code>OR</code><p>Amplía la búsqueda con <strong>cualquiera</strong> de los términos o sinónimos.</p></div>
        <div class="engine-op"><code>NOT</code><p>Excluye resultados que contengan esa palabra.</p></div>
        <div class="engine-op"><code title="Ejemplo: educacion*">palabra*</code><p>El asterisco busca variantes y plurales de una raíz.</p></div>
        <div class="engine-op"><code>site:</code><p>Limita los resultados a un dominio o sitio concreto.</p></div>
        <div class="engine-op"><code>filetype:pdf</code><p>Recupera solo documentos de un formato específico.</p></div>
        <div class="engine-op"><code>&quot;autor:&quot;</code><p>Localiza los trabajos de una autora o autor concreto.</p></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Búsqueda + filtros + paginación en un solo lugar.
  // Todo se controla con la clase .hidden (nada de estilos inline), para que
  // los tres comportamientos no se pisen entre sí.
  const ITEMS_PER_PAGE = 5;

  const allItems = Array.from(document.querySelectorAll('.program-list-item'));
  const filterBtns = Array.from(document.querySelectorAll('.filter-btn'));
  const searchInput = document.getElementById('program-search-input');
  const searchBtn = document.getElementById('program-search-btn');
  const pagesContainer = document.getElementById('pagination-pages');
  const prevBtn = document.getElementById('pagination-prev');
  const nextBtn = document.getElementById('pagination-next');
  const emptyMsg = document.getElementById('program-empty');
  const feedback = document.getElementById('search-feedback');

  // Sin tildes: "catalogo" debe encontrar "Catálogo"
  const normalize = (s) => (s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  // Para pintar la consulta del usuario en innerHTML sin riesgo
  const esc = (s) => (s || '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // Texto buscable de cada materia, calculado una sola vez
  const haystack = new Map(allItems.map((el) => [el, normalize(el.textContent)]));

  let currentFilter = 'all';
  let currentQuery = '';
  let currentPage = 1;

  function getMatches() {
    return allItems.filter((item) => {
      const okFilter = currentFilter === 'all' || item.dataset.category === currentFilter;
      const okQuery = currentQuery === '' || haystack.get(item).includes(currentQuery);
      return okFilter && okQuery;
    });
  }

  function render() {
    const matches = getMatches();
    const totalPages = Math.max(1, Math.ceil(matches.length / ITEMS_PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;

    // Se recorren TODOS los items, no solo los que coinciden: si no hay
    // resultados hay que ocultar los que estaban visibles.
    const visible = new Set(
      matches.slice((currentPage - 1) * ITEMS_PER_PAGE, currentPage * ITEMS_PER_PAGE)
    );
    allItems.forEach((item) => item.classList.toggle('hidden', !visible.has(item)));

    if (prevBtn) prevBtn.disabled = currentPage === 1;
    if (nextBtn) nextBtn.disabled = currentPage === totalPages;
    renderPages(totalPages);

    if (emptyMsg) emptyMsg.hidden = matches.length > 0;
    updateFeedback(matches.length);
  }

  // Se actualiza aquí para que la respuesta se vea en la propia caja de
  // búsqueda: si no, hay que bajar a la lista para enterarse de algo.
  function updateFeedback(count) {
    if (!feedback) return;
    const total = allItems.length;
    const hayCriterio = currentQuery !== '' || currentFilter !== 'all';
    const consulta = currentQuery ? ` para <strong>«${esc(currentQuery)}»</strong>` : '';

    feedback.classList.toggle('is-empty', count === 0);

    if (count === 0) {
      feedback.innerHTML = `Sin materias que coincidan${consulta}`;
    } else if (hayCriterio) {
      feedback.innerHTML = `<strong>${count}</strong> de ${total} materias${consulta}`;
    } else {
      feedback.innerHTML = `<strong>${total}</strong> materias`;
    }
  }

  function renderPages(totalPages) {
    if (!pagesContainer) return;
    pagesContainer.innerHTML = '';
    for (let i = 1; i <= totalPages; i++) {
      const btn = document.createElement('button');
      btn.className = 'pagination-page' + (i === currentPage ? ' active' : '');
      btn.textContent = i;
      btn.setAttribute('aria-label', 'Página ' + i);
      btn.addEventListener('click', () => {
        currentPage = i;
        render();
      });
      pagesContainer.appendChild(btn);
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.filter || 'all';
      currentPage = 1;
      render();
    });
  });

  function applySearch() {
    currentQuery = normalize(searchInput?.value).trim();
    currentPage = 1;
    render();
  }

  // La lista está lejos de la caja, así que al pedir la búsqueda de forma
  // explícita (Enter o la lupa) saltamos a los resultados.
  function goToResults(behavior = 'smooth') {
    document.getElementById('grado')?.scrollIntoView({ behavior, block: 'start' });
  }

  if (searchInput) {
    searchInput.addEventListener('input', applySearch);
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); applySearch(); goToResults(); }
      if (e.key === 'Escape') { searchInput.value = ''; applySearch(); }
    });
  }
  if (searchBtn) searchBtn.addEventListener('click', () => { applySearch(); goToResults(); });
  if (prevBtn) prevBtn.addEventListener('click', () => { if (currentPage > 1) { currentPage--; render(); } });
  if (nextBtn) nextBtn.addEventListener('click', () => { if (currentPage < Math.ceil(getMatches().length / ITEMS_PER_PAGE)) { currentPage++; render(); } });

  // Llegada desde el buscador del encabezado: /estudios?q=nombre+materia
  const initialQuery = new URLSearchParams(window.location.search).get('q');
  if (initialQuery && searchInput) {
    searchInput.value = initialQuery;
    applySearch();
    requestAnimationFrame(() => goToResults('auto'));
  } else {
    render();
  }

  // Filtro de buscadores por categoría
  const engineFilterBtns = Array.from(document.querySelectorAll('.engine-filter'));
  const engineGroups = Array.from(document.querySelectorAll('.engine-group'));
  engineFilterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      engineFilterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.engineFilter || 'all';
      engineGroups.forEach((group) => {
        const show = filter === 'all' || group.dataset.engineCategory === filter;
        group.hidden = !show;
      });
    });
  });
</script>

<style>
  /* La foto de estudios es muy luminosa: scrim algo más fuerte que el estándar
     para que el texto blanco lea bien sin ocultar la imagen */
  .hero--compact .hero-overlay {
    background:
      radial-gradient(
        ellipse 70% 68% at 50% 52%,
        rgba(1,45,23, 0.68) 0%,
        rgba(1,45,23, 0.4) 45%,
        transparent 78%
      ),
      linear-gradient(
        180deg,
        rgba(1,45,23, 0.42) 0%,
        rgba(0,121,63, 0.22) 50%,
        rgba(1,45,23, 0.5) 100%
      );
  }
</style>
</BaseLayout>
