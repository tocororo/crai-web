---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';

const programas = (await getCollection('programas')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const categoryLabel: Record<string, string> = {
  grado: 'Grado',
  posgrado: 'Posgrado',
  doctorado: 'Doctorado',
};

const intercambio = (await getCollection('intercambio')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout title="Oferta Académica - CRAI" description="Explora la oferta académica del CRAI: programas de grado, posgrado y doctorado en todas las áreas del conocimiento.">
  <PageHero
    badgeIcon="fa-graduation-cap"
    badge="Oferta Académica"
    title="Programas de Estudio"
    subtitle="Programas de excelencia para tu futuro profesional"
    crumb="Estudios"
  />

  <!-- Program Search -->
  <section class="section section-search" aria-labelledby="search-title">
    <div class="container">
      <h2 class="section-title" id="search-title">Busca tu programa ideal</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <div class="search-controls">
        <div class="search-box">
          <input type="text" id="program-search-input" placeholder="Buscar programas..." aria-label="Buscar programas académicos" />
          <button id="program-search-btn" aria-label="Buscar"><i class="fas fa-search"></i></button>
        </div>
        <div class="filter-buttons">
          <button class="filter-btn active" data-filter="all">Todos</button>
          <button class="filter-btn" data-filter="grado">Grado</button>
          <button class="filter-btn" data-filter="posgrado">Posgrado</button>
          <button class="filter-btn" data-filter="doctorado">Doctorado</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Program Listing -->
  <section id="grado" class="section" style="background: var(--bg-light);" aria-labelledby="programas-title">
    <div class="container">
      <h2 class="section-title" id="programas-title">Nuestros Programas</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Más de 45 programas diseñados para impulsar tu carrera profesional</p>
      <div class="program-list">
        {programas.map((p) => (
          <div class="program-list-item reveal" data-category={p.data.category}>
            <div class="program-list-icon"><i class={`fas ${p.data.icon}`}></i></div>
            <div class="program-list-body">
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <div class="program-meta">
                <span><i class="fas fa-graduation-cap" aria-hidden="true"></i> {categoryLabel[p.data.category]}</span>
                {p.data.duration && <span><i class="far fa-clock" aria-hidden="true"></i> {p.data.duration}</span>}
                {p.data.modality && <span><i class="fas fa-map-marker-alt" aria-hidden="true"></i> {p.data.modality}</span>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Programas de Intercambio -->
  <section class="section" id="intercambio" aria-labelledby="intercambio-title">
    <div class="container">
      <h2 class="section-title" id="intercambio-title">Programas de Intercambio</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Amplía tus horizontes académicos y culturales en universidades de todo el mundo</p>
      <div class="content-grid">
        {intercambio.map((i) => (
          <div class="content-card reveal">
            <div class="content-card-icon"><i class={i.data.icon}></i></div>
            <h3>{i.data.title}</h3>
            <p>{i.data.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center" style="margin-top: 2rem;">
        <a href="#" class="btn btn-gold"><i class="fas fa-globe"></i> Más información sobre intercambios</a>
      </div>
    </div>
  </section>
</BaseLayout>
