---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const grupos = [
  { area: 'Inteligencia Artificial', icon: 'fas fa-robot', title: 'Grupo de IA y Robótica', desc: 'Desarrollamos sistemas inteligentes y robóticos para resolver problemas complejos en automatización, procesamiento de lenguaje natural y visión por computadora. Colaboramos con centros de investigación líderes a nivel global.' },
  { area: 'Biotecnología', icon: 'fas fa-dna', title: 'Grupo de Biotecnología', desc: 'Investigamos en ingeniería genética, bioprocesos y biomateriales para aplicaciones en salud, agricultura y medio ambiente. Nuestros hallazgos han sido publicados en revistas científicas de alto impacto.' },
  { area: 'Ciencias Sociales', icon: 'fas fa-users', title: 'Grupo de Ciencias Sociales y Desarrollo', desc: 'Estudiamos fenómenos sociales contemporáneos para proponer soluciones basadas en evidencia que promuevan el desarrollo sostenible, la equidad y la inclusión en comunidades vulnerables.' },
];

const proyectos = [
  { icon: 'fas fa-microchip', area: '2024-2027', title: 'Sistemas Autónomos para Industria 4.0', desc: 'Desarrollo de plataformas robóticas autónomas integradas con inteligencia artificial para optimizar procesos productivos en la industria manufacturera. Financiado por el Ministerio de Ciencia.' },
  { icon: 'fas fa-leaf', area: '2024-2026', title: 'Biorremediación de Suelos Contaminados', desc: 'Uso de microorganismos modificados genéticamente para la recuperación de suelos afectados por metales pesados y compuestos petroquímicos. Proyecto en colaboración con el Instituto de Ciencias Ambientales.' },
  { icon: 'fas fa-city', area: '2025-2028', title: 'Desarrollo Urbano Sostenible e Inclusivo', desc: 'Investigación interdisciplinaria sobre políticas públicas de desarrollo urbano que promuevan la sostenibilidad ambiental, la movilidad equitativa y la participación ciudadana en ciudades de América Latina.' },
];

const publicaciones = [
  { icon: 'fas fa-file-alt', title: 'Deep Reinforcement Learning for Autonomous Navigation in Dynamic Environments', authors: 'García, M., Rodríguez, L., & Kim, J.', meta: 'IEEE Transactions on Robotics, 2026' },
  { icon: 'fas fa-dna', title: 'Engineering Synthetic Microbial Consortia for Enhanced Biodegradation of Hydrocarbon Pollutants', authors: 'Martínez, P., López, A., & Chen, S.', meta: 'Nature Biotechnology, 2025' },
  { icon: 'fas fa-chart-bar', title: 'Social Innovation and Inclusive Development: A Participatory Action Research Framework for Latin American Cities', authors: 'Hernández, R., Ferreira, T., & Osei, K.', meta: 'Journal of Social Policy & Development, 2026' },
];

const transferencia = [
  { area: 'Vinculación', icon: 'fas fa-handshake', title: 'Colaboración Empresa-Universidad', desc: 'Establecemos alianzas estratégicas con empresas y organizaciones para transferir conocimiento y tecnología, fomentando la innovación abierta y el desarrollo de soluciones aplicadas a desafíos reales del mercado.' },
  { area: 'Innovación', icon: 'fas fa-lightbulb', title: 'Oficina de Patentes y Spin-offs', desc: 'Apoyamos a los investigadores en la protección de su propiedad intelectual y en la creación de empresas de base tecnológica. Hasta la fecha, se han generado 12 patentes internacionales y 5 spin-offs exitosas.' },
  { area: 'Divulgación', icon: 'fas fa-chalkboard-teacher', title: 'Programas de Divulgación Científica', desc: 'Organizamos conferencias, talleres y ferias de ciencia para acercar el conocimiento académico a la comunidad. Nuestros investigadores participan activamente en medios de comunicación y foros de política científica.' },
];

const convocatorias = [
  { icon: 'fas fa-trophy', area: 'Hasta 50.000 €', title: 'Ayudas a Proyectos de Investigación Joven', desc: 'Dirigido a investigadores emergentes para desarrollar proyectos innovadores con una duración máxima de 24 meses. Incluye financiación para equipamiento, personal y movilidad.' },
  { icon: 'fas fa-globe', area: 'Hasta 200.000 €', title: 'Convocatoria de Innovación Social', desc: 'Proyectos interdisciplinarios que aborden desafíos sociales como desigualdad, cambio climático y salud comunitaria. Se valorará el impacto social y la participación de actores locales.' },
  { icon: 'fas fa-exchange-alt', area: 'Hasta 15.000 €', title: 'Becas de Movilidad Internacional', desc: 'Apoyo a investigadores para estancias cortas en centros de excelencia internacional. Las solicitudes se evalúan de forma continua hasta agotar el presupuesto disponible.' },
];

const colaboraciones = [
  { area: 'Europa', icon: 'fas fa-flask', title: 'Max Planck Institute (Alemania)', desc: 'Colaboración en inteligencia artificial y robótica avanzada. Programas de intercambio de investigadores y proyectos conjuntos financiados por la Unión Europea.' },
  { area: 'América del Norte', icon: 'fas fa-university', title: 'Massachusetts Institute of Technology (EE.UU.)', desc: 'Proyectos conjuntos en biotecnología y ciencia de materiales. Programa de doble titulación doctoral y estancias de investigación para estudiantes de posgrado.' },
  { area: 'Asia', icon: 'fas fa-leaf', title: 'Universidad de Tokio (Japón)', desc: 'Investigación colaborativa en energías renovables y desarrollo sostenible. Intercambio académico y organización conjunta de simposios internacionales.' },
];
---

<BaseLayout title="Investigación – CRAI" description="Investigación e Innovación en el CRAI. Grupos de investigación, proyectos activos, publicaciones científicas y convocatorias.">
  <PageHero
    badgeIcon="fa-flask"
    badge="Investigación"
    title="Investigación e Innovación"
    subtitle="Generamos conocimiento que transforma la sociedad"
    crumb="Investigación"
  />

  <!-- GRUPOS DE INVESTIGACIÓN -->
  <section class="section" aria-labelledby="grupos-title">
    <div class="container">
      <h2 class="section-title" id="grupos-title">Grupos de Investigación</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Nuestros equipos multidisciplinarios trabajan en las fronteras del conocimiento</p>
      <div class="research-grid">
        {grupos.map((g) => (
          <div class="research-card reveal">
            <span class="research-area"><i class={g.icon} aria-hidden="true"></i> {g.area}</span>
            <h3>{g.title}</h3>
            <p>{g.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROYECTOS ACTIVOS -->
  <section id="proyectos" class="section" style="background: var(--bg-light);" aria-labelledby="proyectos-title">
    <div class="container">
      <h2 class="section-title" id="proyectos-title">Proyectos Activos</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Proyectos de investigación financiados y en curso</p>
      <div class="research-grid">
        {proyectos.map((p) => (
          <div class="research-card reveal">
            <span class="research-area"><i class={p.icon} aria-hidden="true"></i> {p.area}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PUBLICACIONES RECIENTES -->
  <section id="publicaciones" class="section" aria-labelledby="publicaciones-title">
    <div class="container">
      <h2 class="section-title" id="publicaciones-title">Publicaciones Recientes</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Artículos científicos y contribuciones académicas de nuestros investigadores</p>
      {publicaciones.map((pub) => (
        <div class="publication-item reveal">
          <div class="pub-icon"><i class={pub.icon} aria-hidden="true"></i></div>
          <div class="pub-info">
            <h4>{pub.title}</h4>
            <p class="pub-authors">{pub.authors}</p>
            <p class="pub-meta">{pub.meta}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- TRANSFERENCIA DE CONOCIMIENTO -->
  <section class="section" style="background: var(--bg-warm);" aria-labelledby="transferencia-title">
    <div class="container">
      <h2 class="section-title" id="transferencia-title">Transferencia de Conocimiento</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Llevamos los resultados de la investigación a la sociedad y al sector productivo</p>
      <div class="research-grid">
        {transferencia.map((t) => (
          <div class="research-card reveal">
            <span class="research-area"><i class={t.icon} aria-hidden="true"></i> {t.area}</span>
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONVOCATORIAS ABIERTAS -->
  <section id="convocatorias" class="section" aria-labelledby="convocatorias-title">
    <div class="container">
      <h2 class="section-title" id="convocatorias-title">Convocatorias Abiertas</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Oportunidades de financiación para proyectos de investigación e innovación</p>
      <div class="research-grid">
        {convocatorias.map((c) => (
          <div class="research-card reveal">
            <span class="research-area"><i class={c.icon} aria-hidden="true"></i> {c.area}</span>
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COLABORACIONES INTERNACIONALES -->
  <section class="section" style="background: var(--bg-light);" aria-labelledby="colaboraciones-title">
    <div class="container">
      <h2 class="section-title" id="colaboraciones-title">Colaboraciones Internacionales</h2>
      <div class="section-divider" aria-hidden="true"></div>
      <p class="section-subtitle">Nuestra red global de socios académicos y de investigación</p>
      <div class="research-grid">
        {colaboraciones.map((c) => (
          <div class="research-card reveal">
            <span class="research-area"><i class={c.icon} aria-hidden="true"></i> {c.area}</span>
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
