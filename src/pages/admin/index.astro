---
const title = 'Panel de administración - CRAI';
const description = 'Panel de administración del sitio CRAI';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
  <style>
    html, body { height: 100%; margin: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: #e2e8f0;
    }
    #boot-loader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0f172a;
      text-align: center;
    }
    .spinner {
      width: 40px; height: 40px;
      border: 4px solid rgba(255,255,255,0.15);
      border-top-color: #22c55e;
      border-radius: 50%;
      margin: 0 auto 16px;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <div id="boot-loader">
    <div>
      <div class="spinner"></div>
      <p>Cargando panel de administración...</p>
    </div>
  </div>
  <script is:inline>
    (function () {
      var boot = document.getElementById('boot-loader');
      if (!boot) return;
      var started = Date.now();
      var t = setInterval(function () {
        if (document.getElementById('nc-root') || Date.now() - started > 20000) {
          boot.remove();
          clearInterval(t);
        }
      }, 150);
    })();
  </script>
  <script is:inline src="/admin/decap-cms.js"></script>
</body>
</html>