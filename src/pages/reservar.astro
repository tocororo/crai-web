---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIcons from '../components/SectionIcons.astro';
---

<BaseLayout title="Reservar Sala — CRAI">
  <main id="main-content">
    <section class="section reservar-section" aria-labelledby="reservar-title">
      <SectionIcons icons={['fa-calendar', 'fa-clock', 'fa-door-open', 'fa-chair']} />
      <div class="container">
        <h2 class="section-title" id="reservar-title">Reservar Sala</h2>
        <div class="section-divider" aria-hidden="true"></div>
        <p class="section-subtitle">Completa el formulario para solicitar una reserva de sala</p>

        <div class="reservar-grid">
          <div class="reservar-card">
            <h3 class="reservar-card-title">
               <i class="fas fa-calendar-check" aria-hidden="true"></i>
               Calendario de Disponibilidad
            </h3>
            <div class="calendar-nav">
              <button class="cal-nav-btn" id="cal-prev" aria-label="Mes anterior"><i class="fas fa-chevron-left"></i></button>
              <h4 class="cal-month" id="cal-month"></h4>
              <button class="cal-nav-btn" id="cal-next" aria-label="Mes siguiente"><i class="fas fa-chevron-right"></i></button>
            </div>
             <div class="calendar" id="calendar">
               <div class="cal-weekdays">
                 <span>Dom</span><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span>
               </div>
               <div class="cal-days" id="cal-days"></div>
             </div>
             <p class="cal-hint">Clic en un día disponible para seleccionar fecha</p>
          </div>

          <div class="reservar-card">
            <h3 class="reservar-card-title">
              <i class="fas fa-file-alt" aria-hidden="true"></i>
              Datos de la Reserva
            </h3>
            <form id="reservation-form" class="reservation-form" novalidate>
              <div class="form-group">
                <label for="res-who">¿Quién Reserva?</label>
                <input type="text" id="res-who" name="nombre" placeholder="Nombre completo" required />
              </div>
              <div class="form-group">
                <label for="res-dept">Departamento</label>
                <input type="text" id="res-dept" name="departamento" placeholder="Ej: Facultad de Ciencias" required />
              </div>
              <div class="form-group">
                <label for="res-email">Correo</label>
                <input type="email" id="res-email" name="correo" placeholder="correo@upr.edu.cu" required />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="res-start">Fecha y Hora de Inicio</label>
                  <input type="datetime-local" id="res-start" name="fecha_inicio" required />
                </div>
                <div class="form-group">
                  <label for="res-end">Fecha y Hora de Término</label>
                  <input type="datetime-local" id="res-end" name="fecha_fin" required />
                </div>
              </div>
              <div class="form-group">
                <label for="res-participants">Cantidad de Participantes</label>
                <input type="number" id="res-participants" name="participantes" placeholder="Ej: 25" min="1" required />
              </div>
              <div class="form-group">
                <label for="res-room">Sala</label>
                <select id="res-room" name="sala" required>
                  <option value="">Selecciona una sala</option>
                  <option value="Sala Abierta">Sala Abierta</option>
                  <option value="Sala de Ciencias Técnicas">Sala de Ciencias Técnicas</option>
                  <option value="Sala de Economía">Sala de Economía</option>
                </select>
              </div>
              <div class="form-group">
                <label for="res-objective">Objetivo de la Actividad</label>
                <textarea id="res-objective" name="objetivo" rows="4" placeholder="Describa brevemente el objetivo de la actividad..." required></textarea>
              </div>
              <button type="submit" class="btn-reserva">
                <i class="fas fa-check-circle" aria-hidden="true"></i> Reservar
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
<script is:inline>
  const HARD_CODED_RESERVED = {
    '2025-07-10': '10:00 - 12:00',
    '2025-07-15': '14:00 - 16:00',
    '2025-07-22': '09:00 - 11:00',
    '2025-07-28': '15:00 - 17:00',
    '2025-08-05': '10:00 - 13:00',
    '2025-08-12': '08:00 - 10:00',
    '2025-08-19': '14:00 - 16:00',
    '2025-08-26': '11:00 - 13:00',
    '2025-09-02': '09:00 - 12:00',
    '2025-09-09': '16:00 - 18:00',
    '2025-09-16': '10:00 - 12:00',
    '2025-09-23': '14:00 - 17:00',
    '2025-09-30': '09:00 - 11:00',
    '2025-10-07': '10:00 - 12:00',
    '2025-10-14': '13:00 - 15:00',
    '2025-10-21': '09:00 - 11:00',
    '2025-10-28': '15:00 - 17:00',
    '2025-11-04': '10:00 - 12:00',
    '2025-11-11': '08:00 - 10:00',
    '2025-11-18': '14:00 - 16:00',
    '2025-11-25': '11:00 - 13:00',
    '2025-12-02': '09:00 - 12:00',
    '2025-12-09': '10:00 - 12:00',
    '2025-12-16': '14:00 - 17:00',
    '2025-12-23': '09:00 - 11:00'
  };

  const UNAVAILABLE_DATES = [
    '2025-07-01','2025-08-01','2025-09-01','2025-10-01','2025-11-01','2025-12-01'
  ];

  const STORAGE_KEY = 'crai_reservations';

  function loadReservations() {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      return stored ? JSON.parse(stored) : {};
    } catch (e) {
      return {};
    }
  }

  function saveReservations(reservations) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(reservations));
  }

  let RESERVED_DATES = Object.assign({}, HARD_CODED_RESERVED, loadReservations());

  let currentDate = new Date();
  let selectedDate = '';

  const calMonthEl = document.getElementById('cal-month');
  const calDaysEl = document.getElementById('cal-days');
  const calPrevBtn = document.getElementById('cal-prev');
  const calNextBtn = document.getElementById('cal-next');
  const form = document.getElementById('reservation-form');
  const startInput = document.getElementById('res-start');
  const endInput = document.getElementById('res-end');

  const MONTHS = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  const WEEKDAYS = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];

  function formatMonthLabel(d) {
    return MONTHS[d.getMonth()] + ' ' + d.getFullYear();
  }

  function formatDateLabel(dateStr) {
    const [y, m, d] = dateStr.split('-');
    return d + ' ' + MONTHS[parseInt(m) - 1] + ' ' + y;
  }

  function isReserved(dateStr) { return RESERVED_DATES.hasOwnProperty(dateStr); }
  function isUnavailable(dateStr) { return UNAVAILABLE_DATES.includes(dateStr); }

  function renderCalendar() {
    calMonthEl.textContent = formatMonthLabel(currentDate);
    calDaysEl.innerHTML = '';
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const daysInPrevMonth = new Date(year, month, 0).getDate();

    for (let i = firstDay - 1; i >= 0; i--) {
      const d = daysInPrevMonth - i;
      const el = document.createElement('span');
      el.className = 'cal-day other-month';
      el.textContent = d;
      calDaysEl.appendChild(el);
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const dateStr = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');
      const el = document.createElement('span');
      el.className = 'cal-day';
      el.textContent = day;
      el.dataset.date = dateStr;

      if (isUnavailable(dateStr)) {
        el.classList.add('unavailable');
        el.title = 'No disponible';
      } else if (isReserved(dateStr)) {
        el.classList.add('reserved');
        const timeLabel = RESERVED_DATES[dateStr];
        el.title = 'Reservada — ' + formatDateLabel(dateStr) + ', ' + timeLabel;
        el.style.cursor = 'not-allowed';
        const timeSpan = document.createElement('span');
        timeSpan.className = 'cal-time';
        timeSpan.textContent = timeLabel;
        el.appendChild(timeSpan);
      } else {
        el.classList.add('available');
        el.addEventListener('click', () => selectDate(dateStr, el));
      }

      if (dateStr === selectedDate) {
        el.classList.add('selected');
      }
      calDaysEl.appendChild(el);
    }

    const totalCells = firstDay + daysInMonth;
    const remaining = (7 - (totalCells % 7)) % 7;
    for (let i = 1; i <= remaining; i++) {
      const el = document.createElement('span');
      el.className = 'cal-day other-month';
      el.textContent = i;
      calDaysEl.appendChild(el);
    }
  }

  function selectDate(dateStr, el) {
    selectedDate = dateStr;
    document.querySelectorAll('.cal-day.selected').forEach(e => e.classList.remove('selected'));
    el.classList.add('selected');
    startInput.value = dateStr + 'T09:00';
  }

  function updateReservedDay(dateStr, timeLabel) {
    const dayEl = document.querySelector('.cal-day[data-date="' + dateStr + '"]');
    if (dayEl) {
      dayEl.classList.remove('available');
      dayEl.classList.add('reserved');
      dayEl.style.cursor = 'not-allowed';
      dayEl.title = 'Reservada — ' + formatDateLabel(dateStr) + ', ' + timeLabel;
      const existing = dayEl.querySelector('.cal-time');
      if (existing) existing.remove();
      const timeSpan = document.createElement('span');
      timeSpan.className = 'cal-time';
      timeSpan.textContent = timeLabel;
      dayEl.appendChild(timeSpan);
    }
  }

  calPrevBtn.addEventListener('click', () => { currentDate.setMonth(currentDate.getMonth() - 1); renderCalendar(); });
  calNextBtn.addEventListener('click', () => { currentDate.setMonth(currentDate.getMonth() + 1); renderCalendar(); });

  renderCalendar();

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    const room = data.sala || 'Sin especificar';
    const subject = 'Reserva de Sala — ' + room;
    const body = 'SOLICITUD DE RESERVA DE SALA\n\n'
      + 'Quién Reserva: ' + data.nombre + '\n'
      + 'Departamento: ' + data.departamento + '\n'
      + 'Correo: ' + data.correo + '\n'
      + 'Fecha/Hora Inicio: ' + data.fecha_inicio + '\n'
      + 'Fecha/Hora Término: ' + data.fecha_fin + '\n'
      + 'Participantes: ' + data.participantes + '\n'
      + 'Sala: ' + room + '\n'
      + 'Objetivo de la Actividad: ' + data.objetivo + '\n\n'
      + 'Enviado desde el sitio web del CRAI.';

    const mailtoLink = 'mailto:crai_institucional@upr.edu.cu?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);

    /* Guardar reserva en localStorage sin re-renderizar todo el calendario */
    if (selectedDate) {
      const startTime = data.fecha_inicio ? data.fecha_inicio.slice(0, 5) : '09:00';
      const endTime = data.fecha_fin ? data.fecha_fin.slice(0, 5) : '11:00';
      RESERVED_DATES[selectedDate] = startTime + ' - ' + endTime;
      saveReservations(RESERVED_DATES);
      updateReservedDay(selectedDate, startTime + ' - ' + endTime);
    }

    window.location.href = mailtoLink;

    setTimeout(() => {
      form.reset();
      selectedDate = '';
      document.querySelectorAll('.cal-day.selected').forEach(e => e.classList.remove('selected'));
      startInput.value = '';
      endInput.value = '';
    }, 1000);
  });
</script>
</BaseLayout>

<style is:inline>
  .reservar-section { background: var(--bg-light); padding: 80px 0; }
  .reservar-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 30px; }
  .reservar-card { background: var(--bg-white); border: 1px solid var(--border-color); border-radius: 12px; padding: 32px; box-shadow: var(--shadow-sm); }
  .reservar-card-title { font-family: var(--font-title); font-size: 1.15rem; font-weight: 600; color: var(--text-primary); margin: 0 0 20px; display: flex; align-items: center; gap: 10px; }
  .reservar-card-title i { color: var(--primary); }

  .calendar-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .cal-month { font-family: var(--font-title); font-size: 1rem; font-weight: 600; color: var(--text-primary); margin: 0; }
  .cal-nav-btn { width: 36px; height: 36px; border: 1px solid var(--border-color); border-radius: 8px; background: var(--bg-white); color: var(--text-primary); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
  .cal-nav-btn:hover { background: var(--bg-light); }
  .calendar { border: 1px solid var(--border-color); border-radius: 10px; overflow: hidden; }
  .cal-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); background: var(--primary); color: var(--text-light); }
  .cal-weekdays span { padding: 10px 4px; text-align: center; font-size: 0.8rem; font-weight: 600; }
  .cal-days { display: grid; grid-template-columns: repeat(7, 1fr); }
  .cal-day { padding: 10px 4px; text-align: center; font-size: 0.85rem; border: 1px solid var(--border-color); cursor: pointer; transition: background 0.2s, color 0.2s; font-family: var(--font-body); color: var(--text-primary); background: var(--bg-white); }
  .cal-day:hover:not(.reserved):not(.unavailable) { background: rgba(23,109,58,0.08); }
  .cal-day.other-month { color: #ccc; cursor: default; }
  .cal-day.selected { background: var(--primary); color: var(--text-light); border-color: var(--primary); }
  .cal-day.available { background: rgba(23,109,58,0.12); font-weight: 600; }
  .cal-day.available:hover { background: rgba(23,109,58,0.22); }
  .cal-day.reserved { background: var(--bg-light); color: #bbb; cursor: not-allowed; text-decoration: line-through; position: relative; }
  .cal-day.unavailable { background: #f5f5f5; color: #ddd; cursor: not-allowed; }
  .cal-day .cal-time { display: block; font-size: 0.65rem; color: var(--primary); font-weight: 700; margin-top: 2px; }
  .cal-hint { text-align: center; font-size: 0.8rem; color: var(--text-secondary); margin-top: 10px; }

  .reservation-form { display: flex; flex-direction: column; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group label { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); }
  .form-group input, .form-group select, .form-group textarea { font-family: var(--font-body); font-size: 0.9rem; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 8px; background: var(--bg-white); color: var(--text-primary); transition: border-color 0.2s, box-shadow 0.2s; outline: none; }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(23,109,58,0.12); }
  .form-group input::placeholder, .form-group textarea::placeholder { color: #bbb; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .btn-reserva { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 14px; border: none; border-radius: 10px; background: var(--primary); color: var(--text-light); font-family: var(--font-title); font-size: 1rem; font-weight: 600; cursor: pointer; transition: background 0.2s, transform 0.15s; margin-top: 8px; }
  .btn-reserva:hover { background: var(--primary-dark); transform: scale(1.02); }
  .btn-reserva:active { transform: scale(0.98); }
  .btn-reserva i { font-size: 1.1rem; }

  @media (max-width: 768px) {
    .reservar-grid { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>

